<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Shared packages (github.com/Little-God1983/LittleGod.Llm…), packed there by each repo's pack.ps1. -->
    <add key="littlegod" value="E:\NuGetFeed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="littlegod">
      <package pattern="LittleGod.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
