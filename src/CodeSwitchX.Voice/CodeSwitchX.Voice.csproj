<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <InternalsVisibleTo Include="CodeSwitchX.Voice.Tests" />
    <!-- ReplyVoice.WhenQuietAsync: the panel's tests wait for the voice to play out before the news's grace. -->
    <InternalsVisibleTo Include="CodeSwitchX.UI.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The sample the warm-up decodes; see WarmUpSpeech.cs. -->
    <EmbeddedResource Include="Dictation\WarmUpSpeech.pcm" LogicalName="CodeSwitchX.Voice.WarmUpSpeech.pcm" />
    <!-- The speech sidecars: the module they share, each engine's script and the pins of its Python packages; written
         into each engine's environment (SidecarScripts). -->
    <EmbeddedResource Include="Speech\Sidecar\tts_sidecar.py" LogicalName="CodeSwitchX.Voice.Sidecar.tts_sidecar.py" />
    <EmbeddedResource Include="Speech\QwenTts\qwen_tts_server.py" LogicalName="CodeSwitchX.Voice.QwenTts.qwen_tts_server.py" />
    <EmbeddedResource Include="Speech\QwenTts\constraints.txt" LogicalName="CodeSwitchX.Voice.QwenTts.constraints.txt" />
    <EmbeddedResource Include="Speech\Kokoro\kokoro_tts_server.py" LogicalName="CodeSwitchX.Voice.Kokoro.kokoro_tts_server.py" />
    <EmbeddedResource Include="Speech\Kokoro\constraints.txt" LogicalName="CodeSwitchX.Voice.Kokoro.constraints.txt" />
    <!-- What the voice setup plays: one clip per voice, "Engine.voice.wav", recorded with the engine itself (VoiceSamples). -->
    <EmbeddedResource Include="Speech\Samples\*.wav" LogicalName="CodeSwitchX.Voice.Samples.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- Open mic's turn detection: Silero VAD and Smart Turn v3, on the CPU (Smart Turn: the model about 15 ms, the features 60-90 ms; see Listening/). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="NAudio.Core" />
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="NAudio.WinMM" />
    <PackageReference Include="Whisper.net" />
    <!-- Two runtimes, and Whisper.net's default RuntimeLibraryOrder already prefers Vulkan over Cpu, so no code
         picks between them: Vulkan loads when its native library can load, Cpu is the automatic fallback when it cannot.
         That fallback covers the native library only. Once a backend is chosen it is fixed for the process.
         Vulkan rather than Cuda12 on purpose: the Cuda12 package has no native code for Blackwell (sm_120). -->
    <PackageReference Include="Whisper.net.Runtime.Vulkan" />
    <PackageReference Include="Whisper.net.Runtime" />
  </ItemGroup>
</Project>
