<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <InternalsVisibleTo Include="CodeSwitchX.Voice.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The chats' sounds (#306), made by scripts/sounds/make-sounds.cs (ShippedSounds). -->
    <EmbeddedResource Include="Audio\Sounds\*.wav" LogicalName="CodeSwitchX.Voice.Sounds.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- AtomicFile: the sound list is replaced as the app's other files are (#392). -->
    <ProjectReference Include="..\CodeSwitchX.Core\CodeSwitchX.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Raven's voice is the shared LittleGod.Speech packages (#328): Listening brings Whisper, Speaking the speakers
         and the reply voice, Kokoro and QwenTts the sidecar and the switch. -->
    <PackageReference Include="LittleGod.Speech.Kokoro" />
    <PackageReference Include="LittleGod.Speech.Listening" />
    <PackageReference Include="LittleGod.Speech.QwenTts" />
    <PackageReference Include="LittleGod.Speech.Speaking" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Whisper's native libraries. The runtime packages copy them by build/ targets only (no buildTransitive), which
         run for a direct reference alone: through LittleGod.Speech.Whisper the app got no whisper.dll and every clip
         failed with "Native Library not found" (#328, found on screen). Vulkan is tried first, the CPU one is the fallback. -->
    <PackageReference Include="Whisper.net.Runtime" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" />
    <!-- The app's own sound pool: WAV reading, Media Foundation for an imported MP3, the resampler. -->
    <PackageReference Include="NAudio.Core" />
    <PackageReference Include="NAudio.Wasapi" />
  </ItemGroup>
</Project>
