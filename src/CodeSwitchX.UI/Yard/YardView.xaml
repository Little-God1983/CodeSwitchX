<UserControl x:Class="CodeSwitchX.UI.Yard.YardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:yard="clr-namespace:CodeSwitchX.UI.Yard"
             xmlns:infra="clr-namespace:CodeSwitchX.UI.Infrastructure"
             xmlns:github="clr-namespace:CodeSwitchX.Core.GitHub;assembly=CodeSwitchX.Core"
             AllowDrop="True" Background="Transparent" DragEnter="OnDragOver" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
  <UserControl.InputBindings>
    <!-- Closes the GitHub panel, wherever in the Yard the keyboard is. With no panel the command is null, so the binding does not match and the key goes on. -->
    <KeyBinding Key="Escape" Command="{Binding GitHubPanel.CloseCommand}" />
  </UserControl.InputBindings>
  <UserControl.Resources>
    <DataTemplate x:Key="ChatRowTemplate" DataType="{x:Type yard:ChatRowViewModel}">
      <!-- A click on the row opens that chat (#115). A button takes the click, so the tile's own click does not fire too. -->
      <Button Command="{Binding OpenCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand"
              AutomationProperties.Name="{Binding Title, StringFormat='Open chat {0}'}" ContextMenuOpening="OnChatMenuOpening">
        <!-- The chat's own menu (#386); a right-click beside the rows opens the tile's. A row with no menu behind it (none in the app:
             every row gets one) shows nothing. -->
        <Button.ContextMenu>
          <ContextMenu Visibility="{Binding HasMenu, Converter={StaticResource BoolVisible}}">
            <MenuItem Header="Compact now" Command="{Binding CompactNowCommand}"
                      ToolTip="Sums the conversation up now, as /compact in its tab would: its tab closes and opens again" />
            <MenuItem Header="{Binding KeepWarmHeader}" IsEnabled="{Binding CanKeepWarm}" ToolTip="{Binding KeepWarmBlock}"
                      ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Keep warm">
              <MenuItem Header="2 hours" Command="{Binding KeepWarmCommand}" CommandParameter="2" />
              <MenuItem Header="4 hours" Command="{Binding KeepWarmCommand}" CommandParameter="4" />
              <MenuItem Header="8 hours" Command="{Binding KeepWarmCommand}" CommandParameter="8" />
            </MenuItem>
            <MenuItem Header="Stop keeping warm" Command="{Binding StopKeepingWarmCommand}"
                      Visibility="{Binding IsKeptWarm, Converter={StaticResource BoolVisible}}" />
          </ContextMenu>
        </Button.ContextMenu>
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Row" Padding="0,2" CornerRadius="4" Background="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#1AFFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="3" />
        </Grid.RowDefinitions>
        <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="{Binding State, Converter={StaticResource StateBrush}}" />
              <Setter Property="ToolTip" Value="{Binding State}" />
              <Style.Triggers>
                <!-- Its tab is open in VS Code, but the chat does not run (#164): a ring, not a dot. -->
                <DataTrigger Binding="{Binding NotRunning}" Value="True">
                  <Setter Property="Fill" Value="Transparent" />
                  <Setter Property="Stroke" Value="#8A94A6" />
                  <Setter Property="StrokeThickness" Value="1.5" />
                  <Setter Property="ToolTip" Value="Not running: its tab is open in VS Code. Click to open it." />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0">
          <TextBlock.ToolTip>
            <TextBlock>
              <Run Text="{Binding State, Mode=OneWay}" /> · <Run Text="{Binding Model, Mode=OneWay}" /> · last tool: <Run Text="{Binding LastToolName, Mode=OneWay}" />
            </TextBlock>
          </TextBlock.ToolTip>
        </TextBlock>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- A chat Raven started: the app runs it, and this says with what. -->
          <Border CornerRadius="4" Background="#2662D0E8" Padding="4,0" Margin="0,0,6,0" VerticalAlignment="Center"
                  Visibility="{Binding IsVoice, Converter={StaticResource BoolVisible}}"
                  ToolTip="Started by Raven: CodeSwitchX runs this chat. Say &quot;open it&quot; to go on in VS Code.">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Foreground="#62D0E8" VerticalAlignment="Center"
                         Margin="0,0,3,0" />
              <TextBlock Text="{Binding VoiceLabel}" FontSize="10" Foreground="#62D0E8" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <TextBlock Text="inferred" FontSize="10" Opacity="0.6" Margin="0,0,6,0"
                     Visibility="{Binding Inferred, Converter={StaticResource BoolVisible}}" ToolTip="Hooks not installed: state guessed from the transcript" />
          <TextBlock Text="{Binding ElapsedText}" FontSize="11" Opacity="0.7" MinWidth="34" TextAlignment="Right" />
          <!-- How warm the chat's prompt cache still is (#331). Hidden rather than collapsed while unknown, so the times of a tile stay in line. -->
          <ProgressBar Width="30" Height="6" Margin="6,0,0,0" VerticalAlignment="Center" Minimum="0" Maximum="1" AutomationProperties.Name="Cache temperature"
                       Value="{Binding CacheFill, Mode=OneWay}" Foreground="{Binding CacheWarmth, Converter={StaticResource CacheBrush}}"
                       BorderThickness="0" Background="#22FFFFFF" ToolTip="{Binding CacheTip}">
            <ProgressBar.Style>
              <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CacheWarmth}" Value="Unknown">
                    <Setter Property="Visibility" Value="Hidden" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ProgressBar.Style>
          </ProgressBar>
          <!-- Kept warm (#386). Hidden rather than collapsed while it is not, so the times of a tile stay in line. -->
          <TextBlock Text="&#x1F525;" FontFamily="Segoe UI Emoji" FontSize="9" Foreground="#F59E0B" Margin="3,0,0,0" VerticalAlignment="Center"
                     AutomationProperties.Name="Kept warm" ToolTip="{Binding KeptWarmTip}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Hidden" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsKeptWarm}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
        <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="4,0,0,0" Height="3" Minimum="0" Maximum="1"
                     Value="{Binding ContextFill, Mode=OneWay}" Foreground="{Binding Pressure, Converter={StaticResource PressureBrush}}"
                     BorderThickness="0" Background="#22FFFFFF" ToolTip="Context window fill" />
      </Grid>
      </Button>
    </DataTemplate>

    <!-- one repository's line: branch (named after its folder when a tile has several), then the git state pill:
         green when clean, amber with uncommitted changes, none when git could not tell -->
    <!-- GitLineTemplate is in App.xaml: Raven's chat header shows the same lines. -->

    <DataTemplate x:Key="TileTemplate" DataType="{x:Type yard:WorkspaceTileViewModel}">
      <!-- the Tile size slider sizes the tile and the Font size slider its text, each apart from the other (#295) -->
      <Border x:Name="TileBorder" Margin="8" Padding="12" CornerRadius="10" BorderThickness="2"
              Width="{Binding DataContext.TileWidth, RelativeSource={RelativeSource AncestorType=yard:YardView}}"
              MinHeight="{Binding DataContext.TileMinHeight, RelativeSource={RelativeSource AncestorType=yard:YardView}}"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Cursor="Hand">
        <Border.InputBindings>
          <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}" />
        </Border.InputBindings>
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Open" Command="{Binding OpenCommand}" />
            <MenuItem Header="Reveal in Explorer" Command="{Binding RevealInExplorerCommand}" />
            <MenuItem Header="Open terminal here" Command="{Binding OpenTerminalCommand}" />
            <Separator />
            <MenuItem Header="Unregister" Command="{Binding UnregisterCommand}" />
          </ContextMenu>
        </Border.ContextMenu>
        <Border.Style>
          <Style TargetType="Border">
            <!-- A local BorderBrush would outrank the trigger below, so the accent lives in the style. -->
            <Setter Property="BorderBrush" Value="{Binding AccentColor, Converter={StaticResource HexBrush}}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                <Setter Property="BorderBrush" Value="#F59E0B" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <!--
            The pulse (spec: the border pulses) is a dark border laid over the tile's amber one, fading in and out so the amber goes dim and bright,
            so the tile's text stays readable. It animates its own Opacity: an animation of the outer border's brush
            colour failed at startup, when the tile is built with a chat already waiting and the brush is not there yet.
          -->
          <Border Margin="-14" CornerRadius="10" BorderThickness="2" BorderBrush="Black" IsHitTestVisible="False">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Opacity" Value="0" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                    <DataTrigger.EnterActions>
                      <BeginStoryboard x:Name="Pulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                          <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="0.6" Duration="0:0:0.7" />
                        </Storyboard>
                      </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                      <StopStoryboard BeginStoryboardName="Pulse" />
                    </DataTrigger.ExitActions>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
          </Border>
          <!-- A chat of the window works (#276): a streak of light runs round the tile's border, over the accent and the amber pulse. -->
          <infra:RunningLight Margin="-14" CornerRadius="10" StrokeThickness="2" Stroke="#22C55E" IsRunning="{Binding IsWorking}" />
          <StackPanel>
          <!-- a layout transform: the text is laid out in the tile's width divided by the font size, so a wider tile fits more of it -->
          <StackPanel.LayoutTransform>
            <ScaleTransform ScaleX="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=yard:YardView}}"
                            ScaleY="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=yard:YardView}}" />
          </StackPanel.LayoutTransform>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" FontSize="11" Opacity="0.7" VerticalAlignment="Center"
                       Text="{Binding HostState, Converter={StaticResource HostStateText}}" />
            <Border DockPanel.Dock="Left" MinWidth="22" Height="22" CornerRadius="11" Padding="6,0" Margin="0,0,8,0" VerticalAlignment="Center"
                    BorderThickness="1" BorderBrush="{Binding AccentColor, Converter={StaticResource HexBrush}}">
              <!-- ToolTip is an object, which a binding's StringFormat leaves alone; a TextBlock's Text is a string. -->
              <Border.ToolTip>
                <TextBlock Text="{Binding Number, StringFormat='Workspace {0}'}" />
              </Border.ToolTip>
              <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <ItemsControl ItemsSource="{Binding GitLines}" ItemTemplate="{StaticResource GitLineTemplate}" Margin="0,4,0,8" yard:GitPills.IsShown="True" />
          <ItemsControl ItemsSource="{Binding ShownChats}" ItemTemplate="{StaticResource ChatRowTemplate}" />
          <!-- the chats that do not fit (#295); a click on it opens the window, as one on the tile does -->
          <TextBlock Text="{Binding MoreChats, StringFormat='+{0} more'}" Opacity="0.7" Margin="18,4,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding MoreChats}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="No Claude Code chats yet" FontStyle="Italic" Opacity="0.5" Margin="0,6,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Chats.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          </StackPanel>
          <!--
            A chat finished a turn the user has not seen (#287): a faint sheen passes across the tile every 4 s, unlike the
            question's amber blink, and with it: each chat of the window adds its own sign. The brush is the rectangle's own, not a style's: a style's value is frozen and cannot be
            animated. With animations turned off in Windows the sheen stands still across the middle.
          -->
          <Rectangle Margin="-14" RadiusX="10" RadiusY="10" IsHitTestVisible="False">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0.2" EndPoint="1,0.8">
                <LinearGradientBrush.RelativeTransform>
                  <TranslateTransform X="0" />
                </LinearGradientBrush.RelativeTransform>
                <GradientStop Color="#00FFFFFF" Offset="0.38" />
                <GradientStop Color="#38FFFFFF" Offset="0.5" />
                <GradientStop Color="#00FFFFFF" Offset="0.62" />
              </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.Style>
              <Style TargetType="Rectangle">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsFinished}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IsFinished}" Value="True" />
                      <Condition Binding="{Binding Path=(SystemParameters.ClientAreaAnimation)}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                      <BeginStoryboard x:Name="Shimmer">
                        <Storyboard RepeatBehavior="Forever" Duration="0:0:4">
                          <DoubleAnimation Storyboard.TargetProperty="Fill.RelativeTransform.X" From="-1" To="1" Duration="0:0:1.2">
                            <DoubleAnimation.EasingFunction>
                              <SineEase EasingMode="EaseInOut" />
                            </DoubleAnimation.EasingFunction>
                          </DoubleAnimation>
                        </Storyboard>
                      </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                      <StopStoryboard BeginStoryboardName="Shimmer" />
                    </MultiDataTrigger.ExitActions>
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </Rectangle.Style>
          </Rectangle>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <DockPanel>
      <Border DockPanel.Dock="Top" Panel.ZIndex="1" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
        <DockPanel>
          <!-- Laid over the board's top edge. Beside the controls a window that is not maximized leaves it no room, and as a row of its own it would move every tile
               when a late failure arrives (#276). The canvas has no height, and the bar's ZIndex draws it above the board. It covers what is under it,
               so a click puts it away instead of reaching a tile it hides; one repository that always fails would otherwise keep it there for good.
               Not focusable: it collapses when clicked, and the keyboard would fall to the window with it. -->
          <Canvas DockPanel.Dock="Bottom" Height="0">
            <Button Canvas.Right="0" Canvas.Top="12" Command="{Binding DismissRefreshMessageCommand}" Focusable="False" Cursor="Hand" ToolTip="Click to put this away"
                    AutomationProperties.Name="{Binding FailureLineText}" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                    Visibility="{Binding FailureLineText, Converter={StaticResource NullToCollapsed}}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border Background="#262626" Padding="8,4" CornerRadius="4">
                    <ContentPresenter />
                  </Border>
                </ControlTemplate>
              </Button.Template>
              <TextBlock Text="{Binding FailureLineText}" Foreground="#F59E0B" TextWrapping="Wrap" />
            </Button>
          </Canvas>
          <!-- Before the controls, so it keeps its width when they run out of room. -->
          <TextBlock Text="Yard" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
          <!-- One row while they fit; in a narrower window they wrap, each label with its slider and percentage, and none is cut off. -->
          <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Tile size" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,8,0" />
              <!-- 5% a tick, an arrow key or a snap; a quarter a page or a click on the track -->
              <Slider Width="120" VerticalAlignment="Center" Minimum="{x:Static yard:YardViewModel.MinTileScale}" Maximum="{x:Static yard:YardViewModel.MaxTileScale}"
                      TickFrequency="0.05" SmallChange="0.05" LargeChange="0.25" IsSnapToTickEnabled="True" AutomationProperties.Name="Tile size"
                      Value="{Binding TileScale}" />
              <TextBlock Text="{Binding TileScale, StringFormat={}{0:P0}}" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" Opacity="0.7"
                         Margin="0,0,16,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Font size" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,8,0" />
              <Slider Width="120" VerticalAlignment="Center" Minimum="{x:Static yard:YardViewModel.MinFontScale}" Maximum="{x:Static yard:YardViewModel.MaxFontScale}"
                      TickFrequency="0.05" SmallChange="0.05" LargeChange="0.25" IsSnapToTickEnabled="True" AutomationProperties.Name="Font size"
                      Value="{Binding FontScale}" />
              <TextBlock Text="{Binding FontScale, StringFormat={}{0:P0}}" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" Opacity="0.7"
                         Margin="0,0,16,0" />
            </StackPanel>
            <CheckBox Content="Needs me first" IsChecked="{Binding NeedsMeFirst}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <!-- Wide enough for "Refreshing…", so the bar does not move when the text changes. It only looks off while it runs: a button WPF disables loses the keyboard. -->
            <Button Content="{Binding RefreshButtonText}" Command="{Binding RefreshCommand}" MinWidth="104" Margin="0,0,8,0"
                    ToolTip="Reads the git info and the GitHub issues and pull requests of every tile now">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                      <Setter Property="Opacity" Value="0.5" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="Add workspace" Command="{Binding AddWorkspaceCommand}" Margin="0,0,8,0" />
            <Button Content="Settings" Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
          </WrapPanel>
          <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#F59E0B" Text="Hooks not installed — states are inferred from transcripts"
                     TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                     Visibility="{Binding HooksInferredOnly, Converter={StaticResource BoolVisible}}" />
        </DockPanel>
      </Border>
      <!-- The tiles keep their places while the pointer is over the board (#276): none slides under a click. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" MouseMove="OnBoardMouseMove" MouseLeave="OnBoardMouseLeave"
                    ContextMenuOpening="OnTileMenuOpening" ContextMenuClosing="OnTileMenuClosing">
        <!-- Now & today, This week, Older (#276): each in a panel of its own, its header with how many tiles it holds; a group
             without tiles is not shown -->
        <ItemsControl ItemsSource="{Binding Groups}" Margin="12,12,12,4">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type yard:LastUseGroupViewModel}">
              <Border Margin="0,0,0,16" Padding="8,10,8,4" CornerRadius="14" BorderThickness="1" BorderBrush="#2EFFFFFF" Background="#0FFFFFFF">
                <Border.Style>
                  <Style TargetType="Border">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Tiles.Count}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="10,0,0,2">
                  <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Tiles.Count, StringFormat='· {0}'}" FontSize="16" Opacity="0.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
    <!-- The panel a repository line or a pill opens (#335, #406): a shade that closes it on a click, and the panel at the right edge. -->
    <Rectangle Fill="#88000000" Visibility="{Binding GitHubPanel, Converter={StaticResource NullToCollapsed}}" MouseLeftButtonDown="OnGitHubShadeClick" />
    <Border x:Name="GitHubPanel" HorizontalAlignment="Right" Width="560" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Background="#262626" BorderThickness="1,0,0,0" BorderBrush="#40FFFFFF" Focusable="False" FocusVisualStyle="{x:Null}" KeyboardNavigation.TabNavigation="Cycle"
            KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
            Visibility="{Binding GitHubPanel, Converter={StaticResource NullToCollapsed}}">
      <DockPanel DataContext="{Binding GitHubPanel}">
        <DockPanel.Resources>
          <!-- why the list could not be read, why a row could not be opened: each shows only while it has something to say -->
          <Style x:Key="GitHubFailureLine" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Top" />
            <Setter Property="Margin" Value="16,0,16,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#F0C674" />
            <Style.Triggers>
              <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
              </Trigger>
            </Style.Triggers>
          </Style>
          <!-- the same line, dim: not a failure -->
          <Style x:Key="GitHubDimLine" TargetType="TextBlock" BasedOn="{StaticResource GitHubFailureLine}">
            <Setter Property="Foreground" Value="#B0B0B0" />
          </Style>
          <!-- A tab's rows. A large repository has up to a thousand rows: only the ones in view are built (#363). Each tab has a list of its
               own, so it keeps its scroll position and a tab shown starts at its top (review of #406). -->
          <Style x:Key="GitHubRows" TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                    <ItemsPresenter Margin="8,0,8,8" />
                  </ScrollViewer>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
              <Setter.Value>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
              <Setter.Value>
                <DataTemplate>
                  <StackPanel>
                  <DockPanel>
                    <!-- Beside the row's button, not in it, so a click copies and opens nothing. Not focusable: a row stays one Tab stop,
                         and the keyboard stays where it was. -->
                    <Button DockPanel.Dock="Right" Command="{Binding DataContext.CopyRowLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                            Content="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Focusable="False" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="6,2" Margin="2,4,0,0"
                            VerticalAlignment="Top" ToolTip="Copy link" AutomationProperties.Name="{Binding NumberText, StringFormat='Copy the link to {0}'}" />
                    <!-- Merge (#408), on pull request rows only: it opens the strip below and does nothing else. In a border of its own, so the
                         button keeps the theme's style. -->
                    <Border DockPanel.Dock="Right" Margin="4,3,0,0" VerticalAlignment="Top">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="PullRequests" />
                                <Condition Binding="{Binding DataContext.CanMerge, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True" />
                              </MultiDataTrigger.Conditions>
                              <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Button Content="Merge" Padding="8,1" Command="{Binding DataContext.OpenMergeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" AutomationProperties.Name="{Binding NumberText, StringFormat='Merge {0}'}"
                              ToolTip="Asks first: a merge cannot be undone" />
                    </Border>
                    <Button Command="{Binding DataContext.OpenRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="8,2"
                            ContentTemplate="{StaticResource GitHubRowTemplate}" Content="{Binding}" AutomationProperties.Name="{Binding NumberText, StringFormat='Open {0}'}" />
                  </DockPanel>
                  <!-- The merge strip (#408), under the row whose Merge was pressed: the question, what happens to the checkout, the choices. -->
                  <Border Margin="8,2,0,6" Padding="10,8" CornerRadius="6" Background="#2D464B" BorderBrush="#4B6F76" BorderThickness="1">
                    <Border.Visibility>
                      <MultiBinding Converter="{StaticResource SameVisible}">
                        <Binding />
                        <Binding Path="DataContext.MergeStrip.Row" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                      </MultiBinding>
                    </Border.Visibility>
                    <StackPanel DataContext="{Binding DataContext.MergeStrip, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                      <TextBlock Text="{Binding Question}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding CheckoutLine}" Margin="0,2,0,8" Opacity="0.8" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal">
                        <Button Content="Merge and pull" Padding="10,3" Margin="0,0,6,0" Style="{DynamicResource AccentButtonStyle}"
                                Command="{Binding DataContext.MergeAndPullCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                Visibility="{Binding OffersPull, Converter={StaticResource BoolVisible}}" AutomationProperties.Name="Merge and pull" />
                        <Button Content="{Binding MergeText}" Padding="10,3" Margin="0,0,6,0" AutomationProperties.Name="{Binding MergeText}"
                                Command="{Binding DataContext.MergeOnlyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        <Button Content="Cancel" Padding="10,3" AutomationProperties.Name="Cancel the merge"
                                Command="{Binding DataContext.CancelMergeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  </StackPanel>
                </DataTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- a tab's name and its arrow: plain text on the tab, each a Tab stop of its own -->
          <Style x:Key="GitHubTabButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="#B0B0B0" />
            <!-- the theme's focus ring: a style of its own drops it, and the classic dotted one is black on the dark panel -->
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </DockPanel.Resources>
        <DockPanel DockPanel.Dock="Top" Margin="16,12,8,8">
          <Button DockPanel.Dock="Right" Content="&#x2715;" Command="{Binding CloseCommand}" VerticalAlignment="Top" AutomationProperties.Name="Close the panel" />
          <StackPanel>
            <!-- The heading opens the repository's main page (#382): a link, so it keeps the look of a heading and is underlined under the pointer. -->
            <Button Command="{Binding OpenRepositoryCommand}" HorizontalAlignment="Left" Cursor="Hand" ToolTip="{Binding OpenRepositoryText}"
                    AutomationProperties.Name="{Binding OpenRepositoryText}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <ContentPresenter />
                </ControlTemplate>
              </Button.Template>
              <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                        <Setter Property="TextDecorations" Value="Underline" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Button>
            <TextBlock Text="{Binding AccountLine}" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
        <!-- Pull (#407): the line's checkout to the default branch, fast-forward. While a pull of this checkout runs the button says so and a
             press does nothing; it stays enabled on purpose: WPF drops the keyboard from a focused button that turns itself off. What the pull
             said stays below it, amber when it was refused or failed. -->
        <StackPanel DockPanel.Dock="Top" Margin="16,0,16,8" Visibility="{Binding PullText, Converter={StaticResource NullToCollapsed}}">
          <Button Content="{Binding PullText}" Command="{Binding PullCommand}" HorizontalAlignment="Left" Padding="10,3"
                  AutomationProperties.Name="{Binding PullAutomationName}"
                  ToolTip="Switches this checkout to the default branch and brings it up to date with GitHub, fast-forward only" />
        </StackPanel>
        <!-- what the last pull or merge came to (#407, #408), its own line: a merge's shows without a pull button too -->
        <StackPanel DockPanel.Dock="Top" Margin="16,0,16,8" Visibility="{Binding ActionMessage, Converter={StaticResource NullToCollapsed}}">
          <TextBlock Text="{Binding ActionMessage}" TextWrapping="Wrap">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#B0B0B0" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsActionFailed}" Value="True">
                    <Setter Property="Foreground" Value="#F0C674" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
        <!-- The tabs (#406): a tab's name shows its list, its arrow opens all of that kind on GitHub. The tab in front has its pill's colours. -->
        <Border DockPanel.Dock="Top" Margin="16,0,16,8" BorderThickness="0,0,0,1" BorderBrush="#40FFFFFF">
          <StackPanel Orientation="Horizontal">
            <Border CornerRadius="6,6,0,0" Margin="0,0,4,0">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="Transparent" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPullRequestsShown}" Value="True">
                      <Setter Property="Background" Value="#2D464B" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Border.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource GitHubTabButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPullRequestsShown}" Value="True">
                      <Setter Property="Foreground" Value="#A6E3E9" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Resources>
              <StackPanel Orientation="Horizontal">
                <Button Content="{Binding PullRequests.TabText}" Command="{Binding ShowCommand}" CommandParameter="{x:Static github:GitHubItemKind.PullRequest}"
                        AutomationProperties.Name="Show pull requests" />
                <Button Content="&#x2197;" Command="{Binding OpenOnGitHubCommand}" CommandParameter="{x:Static github:GitHubItemKind.PullRequest}" Padding="2,4,8,4"
                        ToolTip="Open all pull requests on GitHub" AutomationProperties.Name="Open all pull requests on GitHub" />
              </StackPanel>
            </Border>
            <Border CornerRadius="6,6,0,0" Margin="0,0,4,0">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="Transparent" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPullRequestsShown}" Value="False">
                      <Setter Property="Background" Value="#3A4250" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Border.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource GitHubTabButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPullRequestsShown}" Value="False">
                      <Setter Property="Foreground" Value="#B9CDF0" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Resources>
              <StackPanel Orientation="Horizontal">
                <Button Content="{Binding Issues.TabText}" Command="{Binding ShowCommand}" CommandParameter="{x:Static github:GitHubItemKind.Issue}"
                        AutomationProperties.Name="Show issues" />
                <Button Content="&#x2197;" Command="{Binding OpenOnGitHubCommand}" CommandParameter="{x:Static github:GitHubItemKind.Issue}" Padding="2,4,8,4"
                        ToolTip="Open all issues on GitHub" AutomationProperties.Name="Open all issues on GitHub" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
        <!-- Always there, so a copy line does not move the rows under the pointer. -->
        <DockPanel DockPanel.Dock="Top" Margin="16,0,16,8">
          <Button DockPanel.Dock="Left" Content="Copy all links" Command="{Binding CopyAllLinksCommand}" Padding="8,2" VerticalAlignment="Top"
                  AutomationProperties.Name="Copy all links" ToolTip="Puts the link of every row on the clipboard, one to a line" />
          <!-- One line: a second would push the rows down, and back when it goes. -->
          <TextBlock Text="{Binding CopyMessage}" ToolTip="{Binding CopyMessage}" Margin="8,0,0,0" Opacity="0.7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <TextBlock Style="{StaticResource GitHubFailureLine}" Text="{Binding OpenMessage}" />
        <TextBlock Style="{StaticResource GitHubFailureLine}" Text="{Binding Shown.LoadMessage}" />
        <TextBlock Style="{StaticResource GitHubFailureLine}" Text="{Binding Shown.CutShortMessage}" />
        <TextBlock Style="{StaticResource GitHubFailureLine}" Text="{Binding Shown.SkippedMessage}" />
        <TextBlock Style="{StaticResource GitHubDimLine}" Text="{Binding Shown.LoadingMessage}" />
        <TextBlock Style="{StaticResource GitHubDimLine}" Text="{Binding Shown.EmptyText}" />
        <!-- the tab in front shows its rows; the other keeps its list, scrolled where it was -->
        <Grid>
          <ItemsControl ItemsSource="{Binding PullRequests.Rows}" Tag="PullRequests">
            <ItemsControl.Style>
              <Style TargetType="ItemsControl" BasedOn="{StaticResource GitHubRows}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsPullRequestsShown}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.Style>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Issues.Rows}">
            <ItemsControl.Style>
              <Style TargetType="ItemsControl" BasedOn="{StaticResource GitHubRows}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsPullRequestsShown}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.Style>
          </ItemsControl>
        </Grid>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
