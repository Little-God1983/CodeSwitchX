<UserControl x:Class="CodeSwitchX.UI.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:voice="clr-namespace:CodeSwitchX.UI.Voice">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" MaxWidth="760" HorizontalAlignment="Left">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Back to Yard" Command="{Binding DataContext.CloseSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
      </DockPanel>

      <TextBlock Text="Claude Code hooks" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,6" />
      <TextBlock TextWrapping="Wrap" Opacity="0.8"
                 Text="CodeSwitchX adds csx-hook.exe to the user-level Claude Code settings so every session reports its state. Existing hooks are kept; a backup is written first." />
      <TextBlock Margin="0,8,0,0"><Run Text="Status: " FontWeight="SemiBold" /><Run Text="{Binding HookStatusText, Mode=OneWay}" /></TextBlock>
      <TextBlock Margin="0,4,0,0" Opacity="0.7"><Run Text="Settings file: " /><Run Text="{Binding SettingsFile, Mode=OneWay}" /></TextBlock>
      <DockPanel Margin="0,8,0,0">
        <TextBlock Text="Relay executable" VerticalAlignment="Center" Width="140" />
        <TextBox Text="{Binding RelayExecutable, UpdateSourceTrigger=LostFocus}" />
      </DockPanel>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <Button Content="Install hooks" Command="{Binding InstallHooksCommand}" MinWidth="120" Margin="0,0,8,0" />
        <Button Content="Remove hooks" Command="{Binding RemoveHooksCommand}" MinWidth="120" />
      </StackPanel>
      <TextBlock Text="{Binding LastMessage}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#2563EB"
                 Visibility="{Binding LastMessage, Converter={StaticResource NullToCollapsed}}" />

      <TextBlock Text="Raven" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,6" />
      <TextBlock TextWrapping="Wrap" Opacity="0.8"
                 Text="Raven answers with Claude Code, which works only through the Yard's tools. A faster model answers sooner; a change starts a new conversation." />
      <DockPanel Margin="0,8,0,0">
        <TextBlock Text="Model" VerticalAlignment="Center" Width="140" />
        <ComboBox IsEditable="True" Width="260" HorizontalAlignment="Left" AutomationProperties.Name="Raven model"
                  ItemsSource="{Binding KnownBrainModels, Mode=OneTime}"
                  Text="{Binding RavenBrainModel, UpdateSourceTrigger=PropertyChanged, Delay=600}"
                  ToolTip="A full model id. Pick one or type another." />
      </DockPanel>
      <DockPanel Margin="0,8,0,0">
        <TextBlock Text="Voice engine" VerticalAlignment="Center" Width="140" />
        <ComboBox Width="360" HorizontalAlignment="Left" AutomationProperties.Name="Raven voice engine"
                  ItemsSource="{Binding EngineChoices, Mode=OneTime}" DisplayMemberPath="Label" SelectedValuePath="Engine"
                  SelectedValue="{Binding RavenVoiceEngine}"
                  ToolTip="Kokoro is about 450 MB and runs on the CPU; Qwen3-TTS is about 5 GB and needs an NVIDIA graphics card. Another engine is installed the next time Raven speaks, or now from Voice setup." />
        <voice:ModelLampView DataContext="{Binding Voice.Speech}" Margin="12,0,0,0" AutomationProperties.ItemType="Raven's voice" />
        <Button Content="Voice setup…" Command="{Binding OpenVoiceSetupCommand}" Margin="12,0,0,0" HorizontalAlignment="Left"
                ToolTip="Pick an engine and a voice, hear them, and install the engine now." />
      </DockPanel>
      <DockPanel Margin="0,8,0,0" Visibility="{Binding HasEngine, Converter={StaticResource BoolVisible}}">
        <TextBlock Text="Voice" VerticalAlignment="Center" Width="140" />
        <ComboBox Width="360" HorizontalAlignment="Left" AutomationProperties.Name="Raven voice"
                  ItemsSource="{Binding VoiceChoices}" SelectedValuePath="Id" SelectedValue="{Binding RavenVoice}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock>
                <Run Text="{Binding Name, Mode=OneTime}" /><Run Text=" · " /><Run Text="{Binding Description, Mode=OneTime}" Foreground="Gray" />
              </TextBlock>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </DockPanel>
      <DockPanel Margin="0,8,0,0" Visibility="{Binding IsQwen, Converter={StaticResource BoolVisible}}">
        <TextBlock Text="Voice model" VerticalAlignment="Center" Width="140" />
        <ComboBox Width="360" HorizontalAlignment="Left" AutomationProperties.Name="Raven voice model"
                  ItemsSource="{Binding VoiceModelChoices, Mode=OneTime}" DisplayMemberPath="Label" SelectedValuePath="Model"
                  SelectedValue="{Binding RavenVoiceModel}"
                  ToolTip="Qwen3-TTS's model. The 1.7B one is downloaded the first time Raven speaks with it (3.5 GB)." />
      </DockPanel>
      <DockPanel Margin="0,8,0,0">
        <TextBlock Text="Speech to text" VerticalAlignment="Center" Width="140" />
        <ComboBox Width="360" HorizontalAlignment="Left" AutomationProperties.Name="Speech-to-text model"
                  ItemsSource="{Binding WhisperChoices, Mode=OneTime}" DisplayMemberPath="Label" SelectedValuePath="Model"
                  SelectedValue="{Binding RavenWhisperModel}"
                  ToolTip="The Whisper model that writes down what you say. The English-only ones are smaller and faster; Large v3 Turbo also hears German. A model not on this PC is downloaded with your next dictation, or now." />
        <voice:ModelLampView DataContext="{Binding Voice.Listening}" Margin="12,0,0,0" AutomationProperties.ItemType="Speech to text" />
        <Button Content="Download" Command="{Binding DownloadWhisperCommand}" Margin="12,0,0,0" HorizontalAlignment="Left"
                Visibility="{Binding WhisperMissing, Converter={StaticResource BoolVisible}}" />
      </DockPanel>
      <CheckBox Margin="140,10,0,0" IsChecked="{Binding RavenSpeakNews}" AutomationProperties.Name="Speak chat news"
                Content="Speak chat news"
                ToolTip="When chats finish, fail or need you, Raven tells you in one remark once nobody is talking. Off, the news is only written in Raven's log." />
      <CheckBox Margin="140,6,0,0" IsChecked="{Binding RavenBargeIn}" AutomationProperties.Name="Stop Raven when I talk over it"
                Content="Stop Raven when I talk over it"
                ToolTip="In Open mic, talking while Raven speaks stops it. Turn this off if Raven hears its own voice through your speakers: Open mic then ignores what it hears while Raven speaks." />

      <TextBlock Text="Chats Raven starts" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,4" />
      <TextBlock TextWrapping="Wrap" Opacity="0.8"
                 Text="They run in auto mode with this model and effort, unless you name others for one chat. &quot;From now on Opus&quot; changes them by voice; default leaves it to Claude Code." />
      <DockPanel Margin="0,8,0,0">
        <TextBlock Text="Model" VerticalAlignment="Center" Width="140" />
        <ComboBox IsEditable="True" Width="260" HorizontalAlignment="Left" AutomationProperties.Name="Chat model"
                  ItemsSource="{Binding ChatModelChoices}"
                  Text="{Binding RavenChatModel, UpdateSourceTrigger=PropertyChanged, Delay=600}"
                  ToolTip="An alias from the table below, a full model id, or default." />
      </DockPanel>
      <DockPanel Margin="0,8,0,0">
        <TextBlock Text="Effort" VerticalAlignment="Center" Width="140" />
        <ComboBox Width="260" HorizontalAlignment="Left" AutomationProperties.Name="Chat effort"
                  ItemsSource="{Binding EffortChoices, Mode=OneTime}" SelectedItem="{Binding RavenChatEffort}" />
      </DockPanel>
      <DockPanel Margin="0,8,0,0">
        <TextBlock Text="Model names" VerticalAlignment="Top" Width="140" Margin="0,4,0,0" />
        <TextBox Text="{Binding RavenModelAliases, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" MinLines="4" Width="360"
                 HorizontalAlignment="Left" FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="Model names"
                 ToolTip="One per line: the name you say = the full model id it starts. Edit a line when a new model comes out." />
      </DockPanel>

      <TextBlock Text="Telemetry" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,6" />
      <DockPanel>
        <TextBlock Text="5-hour soft budget (tokens)" VerticalAlignment="Center" Width="200" />
        <TextBox Text="{Binding FiveHourBudgetTokens, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Width="160" HorizontalAlignment="Left"
                 ToolTip="Leave empty for no budget. CodeSwitchX cannot read your real plan limit; this is a reminder line, not a hard limit." />
      </DockPanel>

      <TextBlock Text="Privacy" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,6" />
      <CheckBox Content="Store raw hook payloads in the database (contains prompts and file paths)" IsChecked="{Binding StorePayloads}" />

      <TextBlock Text="Data" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,6" />
      <TextBlock><Run Text="Folder: " /><Run Text="{Binding DataFolder, Mode=OneWay}" /></TextBlock>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
        <Button Content="Open logs" Command="{Binding OpenLogsFolderCommand}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
