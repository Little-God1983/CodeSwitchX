<Window x:Class="CodeSwitchX.UI.Shell.ExitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exit CodeSwitchX" Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
  <!-- #420: Exit asks whether the VS Code windows close too; the main window's X never asks and leaves them open. -->
  <StackPanel Margin="16">
    <TextBlock x:Name="Question" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="Detail" Margin="0,6,0,14" TextWrapping="Wrap" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Close all" Click="CloseAll" Margin="0,0,8,0" Padding="12,4"
              ToolTip="Closes CodeSwitchX and asks each of these VS Code windows to close" />
      <!-- Enter takes the choice that loses nothing. -->
      <Button Content="Close only CodeSwitchX" Click="CloseOnly" Margin="0,0,8,0" Padding="12,4" IsDefault="True"
              ToolTip="Closes CodeSwitchX; the VS Code windows stay open on the desktop" />
      <Button Content="Cancel" Click="Cancel" Padding="12,4" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
