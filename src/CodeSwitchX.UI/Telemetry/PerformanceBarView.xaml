<UserControl x:Class="CodeSwitchX.UI.Telemetry.PerformanceBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:voice="clr-namespace:CodeSwitchX.UI.Voice"
             xmlns:infra="clr-namespace:CodeSwitchX.UI.Infrastructure"
             xmlns:settings="clr-namespace:CodeSwitchX.UI.Settings">
  <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="12,4">
    <!-- On a narrow window the bar gives way instead of running its texts into each other (#168): first the models' names
         fold, leaving their dots and states, then the rate sparkline goes, then today's cost. -->
    <infra:GiveWayBar>
      <DockPanel>
        <DockPanel.Resources>
          <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
          <!-- A model's name and dot, as a link to the Settings page where that model is chosen. -->
          <Style TargetType="Button" x:Key="DotLink">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Box" Background="Transparent" CornerRadius="4" Padding="4,1">
                    <ContentPresenter VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Box" Property="Background" Value="#1F2937" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <Style TargetType="TextBlock" x:Key="Value">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
        </DockPanel.Resources>
        <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsExpanded}" Content="&#x25BE;" BorderThickness="0" Background="Transparent" Padding="6,0" ToolTip="Collapse or expand" />
        <!-- Where Raven's models stand: red not downloaded or failed, grey asleep, yellow on its way, green ready. -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisible}}">
          <Button Style="{StaticResource DotLink}" Margin="0,0,14,0" ToolTip="{Binding Voice.Speech.Detail}" AutomationProperties.Name="Voice settings"
                  Command="{Binding DataContext.OpenSettingsAtCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="{x:Static settings:SettingsPage.Voice}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Label}" Text="{Binding Voice.SpeechName}" Margin="0,0,6,0" infra:GiveWayBar.Step="1" />
              <voice:ModelLampView DataContext="{Binding Voice.Speech}" AutomationProperties.ItemType="Raven's voice" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource DotLink}" Margin="0,0,8,0" ToolTip="{Binding Voice.Listening.Detail}" AutomationProperties.Name="Listening settings"
                  Command="{Binding DataContext.OpenSettingsAtCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="{x:Static settings:SettingsPage.Listening}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Label}" Text="{Binding Voice.ListeningName}" Margin="0,0,6,0" infra:GiveWayBar.Step="1" />
              <voice:ModelLampView DataContext="{Binding Voice.Listening}" AutomationProperties.ItemType="Speech to text" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisible}}">
          <TextBlock Style="{StaticResource Label}" Text="tokens today" />
          <TextBlock Style="{StaticResource Value}" Text="{Binding TokensTodayText}" />
          <StackPanel Orientation="Horizontal" infra:GiveWayBar.Step="3">
            <TextBlock Style="{StaticResource Label}" Text="cost today" />
            <TextBlock Style="{StaticResource Value}" Text="{Binding CostTodayText}" ToolTip="Estimate from the editable pricing table; a model without a rule adds tokens but no cost" />
          </StackPanel>
          <TextBlock Style="{StaticResource Label}" Text="5-hour window" />
          <TextBlock Style="{StaticResource Value}" Text="{Binding FiveHourText}" Margin="0,0,6,0" />
          <ProgressBar Width="90" Height="6" Minimum="0" Maximum="100" Value="{Binding FiveHourPercent, Mode=OneWay}" Margin="0,0,20,0" VerticalAlignment="Center"
                       Visibility="{Binding HasBudget, Converter={StaticResource BoolVisible}}" />
          <StackPanel Orientation="Horizontal" infra:GiveWayBar.Step="2">
            <TextBlock Style="{StaticResource Label}" Text="rate (60 min)" />
            <Canvas x:Name="Sparkline" Width="120" Height="18" Margin="0,0,20,0" VerticalAlignment="Center" ClipToBounds="True">
              <Polyline x:Name="SparklinePath" Stroke="#3B82F6" StrokeThickness="1.5" StrokeLineJoin="Round" />
            </Canvas>
          </StackPanel>
          <TextBlock Style="{StaticResource Label}" Text="active chats" />
          <TextBlock Style="{StaticResource Value}" Text="{Binding ActiveSessions}" />
          <TextBlock Style="{StaticResource Label}" Text="waiting" />
          <TextBlock Style="{StaticResource Value}" Text="{Binding WaitingSessions}" Foreground="#F59E0B" />
        </StackPanel>
      </DockPanel>
    </infra:GiveWayBar>
  </Border>
</UserControl>
