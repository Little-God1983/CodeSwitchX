<UserControl x:Class="CodeSwitchX.UI.Telemetry.PerformanceBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:voice="clr-namespace:CodeSwitchX.UI.Voice"
             xmlns:infra="clr-namespace:CodeSwitchX.UI.Infrastructure"
             xmlns:settings="clr-namespace:CodeSwitchX.UI.Settings"
             xmlns:tel="clr-namespace:CodeSwitchX.UI.Telemetry"
             xmlns:cache="clr-namespace:CodeSwitchX.Telemetry;assembly=CodeSwitchX.Telemetry">
  <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="12,4">
    <!-- On a narrow window the bar gives way instead of running its texts into each other (#168): first the models' names
         fold, leaving their dots and states, then the week's short text (#384). The two limit bars and the 5-hour text stay
         (#370): the 5-hour limit is the one that stops the work soonest. -->
    <infra:GiveWayBar>
      <DockPanel>
        <DockPanel.Resources>
          <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
          <!-- A model's name and dot, as a link to the Settings page where that model is chosen. -->
          <Style TargetType="Button" x:Key="DotLink">
            <!-- Replacing the theme's button style loses its text colour: without this the text falls back to the system's black. -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Box" Background="Transparent" CornerRadius="4" Padding="4,1">
                    <ContentPresenter VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Box" Property="Background" Value="#1F2937" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <Style TargetType="TextBlock" x:Key="Value">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
        </DockPanel.Resources>
        <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsExpanded}" Content="&#x25BE;" BorderThickness="0" Background="Transparent" Padding="6,0" ToolTip="Collapse or expand" />
        <!-- Where Raven's models stand: red not downloaded or failed, grey asleep, yellow on its way, green ready. -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisible}}">
          <Button Style="{StaticResource DotLink}" Margin="0,0,14,0" ToolTip="{Binding Voice.Speech.Detail}" AutomationProperties.Name="Voice settings"
                  Command="{Binding DataContext.OpenSettingsAtCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="{x:Static settings:SettingsPage.Voice}">
            <StackPanel Orientation="Horizontal">
              <infra:GiveWay Step="1">
                <TextBlock Style="{StaticResource Label}" Text="{Binding Voice.SpeechName}" Margin="0,0,6,0" />
              </infra:GiveWay>
              <voice:ModelLampView DataContext="{Binding Voice.Speech}" AutomationProperties.ItemType="Raven's voice" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource DotLink}" Margin="0,0,8,0" ToolTip="{Binding Voice.Listening.Detail}" AutomationProperties.Name="Listening settings"
                  Command="{Binding DataContext.OpenSettingsAtCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="{x:Static settings:SettingsPage.Listening}">
            <StackPanel Orientation="Horizontal">
              <infra:GiveWay Step="1">
                <TextBlock Style="{StaticResource Label}" Text="{Binding Voice.ListeningName}" Margin="0,0,6,0" />
              </infra:GiveWay>
              <voice:ModelLampView DataContext="{Binding Voice.Listening}" AutomationProperties.ItemType="Speech to text" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisible}}">
          <!-- Hidden for now (#384), kept for statistics later: tokens and cost today, the counted 5-hour figure and the rate
               sparkline. Their data still flows; to bring one back, move it out of this panel. Under a collapsed panel their
               GiveWay steps take no part in the folding. -->
          <StackPanel Orientation="Horizontal" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Label}" Text="tokens today" />
            <TextBlock Style="{StaticResource Value}" Text="{Binding TokensTodayText}" />
            <infra:GiveWay Step="5">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Label}" Text="cost today" />
                <TextBlock Style="{StaticResource Value}" Text="{Binding CostTodayText}" ToolTip="Estimate from the editable pricing table; a model without a rule adds tokens but no cost" />
              </StackPanel>
            </infra:GiveWay>
            <infra:GiveWay Step="6">
              <!-- The group's margin is the gap that stays when the progress bar is gone, so this figure never runs into the real limit. -->
              <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                <TextBlock Style="{StaticResource Label}" Text="5-hour window" />
                <TextBlock Style="{StaticResource Value}" Text="{Binding FiveHourText}" Margin="0,0,6,0" />
                <ProgressBar Width="90" Height="6" Minimum="0" Maximum="100" Value="{Binding FiveHourPercent, Mode=OneWay}" Margin="0,0,6,0" VerticalAlignment="Center"
                             Visibility="{Binding HasBudget, Converter={StaticResource BoolVisible}}" />
              </StackPanel>
            </infra:GiveWay>
            <infra:GiveWay Step="4">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Label}" Text="rate (60 min)" />
                <Canvas x:Name="Sparkline" Width="120" Height="18" Margin="0,0,20,0" VerticalAlignment="Center" ClipToBounds="True">
                  <Polyline x:Name="SparklinePath" Stroke="#3B82F6" StrokeThickness="1.5" StrokeLineJoin="Round" />
                </Canvas>
              </StackPanel>
            </infra:GiveWay>
          </StackPanel>
          <!-- The plan's real limits as bars (#370, #384): spent, and a mark for how much of the window has passed; amber when
               spent more than 10 points ahead of it. Nothing at all without a subscription or while none could be read. The bars never fold;
               of their short texts only the week's does: the 5-hour limit stops the work soonest. -->
          <StackPanel Orientation="Horizontal" Margin="0,0,20,0" Background="Transparent"
                      Visibility="{Binding Limits.FiveHourBar, Converter={StaticResource NullToCollapsed}}">
            <StackPanel.ToolTip>
              <StackPanel>
                <TextBlock Text="{Binding Limits.FiveHourText}" FontWeight="SemiBold" />
                <TextBlock Text="The mark is how much of the 5 hours has passed; amber: spent more than 10 points ahead of it." />
                <TextBlock Text="{Binding Limits.Detail}" Opacity="0.7" />
              </StackPanel>
            </StackPanel.ToolTip>
            <TextBlock Style="{StaticResource Label}" Text="5h" Margin="0,0,6,0" />
            <tel:LimitBar Width="90" Height="10" VerticalAlignment="Center" State="{Binding Limits.FiveHourBar}"
                          MarkBrush="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.Name="5-hour limit"
                          AutomationProperties.HelpText="{Binding Limits.FiveHourText}" />
            <!-- Never folds (#370): an empty bar after a reset says "reading again…" only here. -->
            <TextBlock Style="{StaticResource Value}" Text="{Binding Limits.FiveHourBar.Text}" Margin="6,0,0,0" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,20,0" Background="Transparent"
                      Visibility="{Binding Limits.WeekBar, Converter={StaticResource NullToCollapsed}}">
            <StackPanel.ToolTip>
              <StackPanel>
                <TextBlock Text="{Binding Limits.WeekText}" FontWeight="SemiBold" />
                <TextBlock Text="The mark is how much of the week has passed; amber: spent more than 10 points ahead of it." />
                <TextBlock Text="{Binding Limits.Detail}" Opacity="0.7" />
              </StackPanel>
            </StackPanel.ToolTip>
            <TextBlock Style="{StaticResource Label}" Text="week" Margin="0,0,6,0" />
            <tel:LimitBar Width="90" Height="10" VerticalAlignment="Center" State="{Binding Limits.WeekBar}"
                          MarkBrush="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.Name="Weekly limit"
                          AutomationProperties.HelpText="{Binding Limits.WeekText}" />
            <infra:GiveWay Step="2">
              <TextBlock Style="{StaticResource Value}" Text="{Binding Limits.WeekBar.Text}" Margin="6,0,0,0" />
            </infra:GiveWay>
          </StackPanel>
          <TextBlock Style="{StaticResource Label}" Text="active chats" />
          <TextBlock Style="{StaticResource Value}" Text="{Binding ActiveSessions}" />
          <TextBlock Style="{StaticResource Label}" Text="waiting" />
          <TextBlock Style="{StaticResource Value}" Text="{Binding WaitingSessions}" Foreground="#F59E0B" />
          <!-- Of the active chats, by the temperature of their cache (#331), in the colours of the Yard's gauges. -->
          <TextBlock Style="{StaticResource Label}" Text="hot" ToolTip="Active chats whose cache has more than 20 minutes left" />
          <TextBlock Style="{StaticResource Value}" Text="{Binding HotChats}"
                     Foreground="{Binding Source={x:Static cache:CacheWarmth.Hot}, Converter={StaticResource CacheBrush}}" />
          <TextBlock Style="{StaticResource Label}" Text="cooling" ToolTip="Active chats whose cache has 20 minutes or less left: go on with them or finish the work in them now" />
          <TextBlock Style="{StaticResource Value}" Text="{Binding CoolingChats}"
                     Foreground="{Binding Source={x:Static cache:CacheWarmth.Warm}, Converter={StaticResource CacheBrush}}" />
        </StackPanel>
      </DockPanel>
    </infra:GiveWayBar>
  </Border>
</UserControl>
