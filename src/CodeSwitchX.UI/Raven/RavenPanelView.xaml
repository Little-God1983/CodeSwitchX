<UserControl x:Class="CodeSwitchX.UI.Raven.RavenPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:raven="clr-namespace:CodeSwitchX.UI.Raven"
             xmlns:infra="clr-namespace:CodeSwitchX.UI.Infrastructure"
             xmlns:settings="clr-namespace:CodeSwitchX.UI.Settings"
             xmlns:shell="clr-namespace:CodeSwitchX.UI.Shell"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance raven:RavenPanelViewModel}"
             d:DesignWidth="320" d:DesignHeight="800">
  <UserControl.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <infra:EnumIsConverter x:Key="EnumIs" />

    <!-- One half of the Push to talk | Open mic switch: a radio button drawn as a pill. -->
    <Style x:Key="ModeSwitch" TargetType="RadioButton">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#9CA3AF" />
      <Setter Property="Background" Value="#1F2937" />
      <Setter Property="BorderBrush" Value="#374151" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Pill" CornerRadius="10" Padding="10,3" BorderThickness="1"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Pill" Property="Background" Value="#2662D0E8" />
                <Setter TargetName="Pill" Property="BorderBrush" Value="#62D0E8" />
                <Setter Property="Foreground" Value="#62D0E8" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A setting shown as a small pill. -->
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="Background" Value="#1F2937" />
      <Setter Property="BorderBrush" Value="#374151" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="8,1,8,2" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <!-- Keyboard focus only (mouse clicks draw none): a ring in the voice colour around the control. -->
    <Style x:Key="FocusRing">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle Margin="-3" RadiusX="8" RadiusY="8" Stroke="#62D0E8" StrokeThickness="2" SnapsToDevicePixels="True" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RoundFocusRing">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Ellipse Margin="-4" Stroke="#62D0E8" StrokeThickness="2" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The chevrons: a quiet square that lights up under the mouse. -->
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Foreground" Value="#9CA3AF" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#1F2937" />
      <Setter Property="FontFamily" Value="{StaticResource Icons}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#D1D5DB" />
                <Setter TargetName="Box" Property="Background" Value="#1F2937" />
                <Setter TargetName="Box" Property="BorderBrush" Value="#374151" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#374151" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The mic: the panel's primary control. Voice colour at rest, red while listening, amber while transcribing. -->
    <Style x:Key="MicButton" TargetType="Button">
      <Setter Property="Width" Value="52" />
      <Setter Property="Height" Value="52" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="#62D0E8" />
      <Setter Property="Background" Value="#2662D0E8" />
      <Setter Property="BorderBrush" Value="#62D0E8" />
      <Setter Property="FontFamily" Value="{StaticResource Icons}" />
      <Setter Property="Content" Value="&#xE720;" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ToolTip" Value="{Binding MicButtonToolTip}" />
      <Setter Property="AutomationProperties.Name" Value="{Binding MicButtonName}" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource RoundFocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Ellipse x:Name="Halo" Margin="-6" Fill="#33EF4444" Visibility="Collapsed" />
              <Ellipse x:Name="Disc" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Disc" Property="Fill" Value="#4062D0E8" />
              </Trigger>
              <DataTrigger Binding="{Binding State}" Value="Listening">
                <Setter Property="Foreground" Value="White" />
                <Setter TargetName="Disc" Property="Fill" Value="#EF4444" />
                <Setter TargetName="Disc" Property="Stroke" Value="#EF4444" />
                <Setter TargetName="Halo" Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding State}" Value="Transcribing">
                <Setter Property="Foreground" Value="#F59E0B" />
                <Setter TargetName="Disc" Property="Fill" Value="#26F59E0B" />
                <Setter TargetName="Disc" Property="Stroke" Value="#F59E0B" />
              </DataTrigger>
              <DataTrigger Binding="{Binding State}" Value="AttendingPaused">
                <Setter Property="Content" Value="&#xEC54;" />
                <Setter Property="Opacity" Value="0.7" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="StateText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#62D0E8" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Text" Value="IDLE" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Listening">
          <Setter Property="Text" Value="LISTENING" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Transcribing">
          <Setter Property="Text" Value="TRANSCRIBING" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Thinking">
          <Setter Property="Text" Value="THINKING" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Speaking">
          <Setter Property="Text" Value="SPEAKING" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Attending">
          <Setter Property="Text" Value="OPEN MIC" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="AttendingPaused">
          <Setter Property="Text" Value="PAUSED" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Speaker on: Raven says its answers. Crossed out: it only writes them. -->
    <Style x:Key="MuteButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Content" Value="&#xE767;" />
      <Setter Property="ToolTip" Value="Raven speaks its answers. Click to mute." />
      <Setter Property="AutomationProperties.Name" Value="Mute Raven" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMuted}" Value="True">
          <Setter Property="Content" Value="&#xE74F;" />
          <Setter Property="ToolTip" Value="Raven is muted: it only writes its answers. Click to hear them." />
          <Setter Property="AutomationProperties.Name" Value="Unmute Raven" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!--
      A window chat's speaker (#153): dim while it speaks, crossed out and lit while muted; a click toggles it. Chat 0 and
      Activity have none: the panel's own mute quiets everything.
    -->
    <Style x:Key="ChatMuteButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#4B5563" />
      <Setter Property="Content" Value="&#xE767;" />
      <Setter Property="ToolTip" Value="Raven speaks this chat's news. Click to mute it; its questions are still read out." />
      <Setter Property="AutomationProperties.Name" Value="{Binding MuteText}" />
      <Setter Property="Command" Value="{Binding ToggleMuteCommand}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMuted}" Value="True">
          <Setter Property="Content" Value="&#xE74F;" />
          <Setter Property="Foreground" Value="#F59E0B" />
          <Setter Property="ToolTip" Value="Muted: this chat's news and catch-up are only written, with no sound; its questions are still read out. Click to hear it again." />
        </DataTrigger>
        <DataTrigger Binding="{Binding CanMute}" Value="False">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Log entries: my words in a box, Raven's replies in a box of its colour, a card per tool it looked at, notes dim,
         warnings amber with a glyph. -->
    <DataTemplate x:Key="YouEntry" DataType="{x:Type raven:RavenLogEntry}">
      <Border Background="#1F2937" CornerRadius="8,8,8,2" Padding="10,7,10,8">
        <StackPanel>
          <TextBlock FontSize="11" Foreground="#9CA3AF" Text="{Binding At.LocalDateTime, StringFormat='You · {0:HH:mm}'}" />
          <TextBlock FontSize="13" Foreground="#E5E7EB" TextWrapping="Wrap" Margin="0,3,0,0" Text="{Binding Text}" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="RavenEntry" DataType="{x:Type raven:RavenLogEntry}">
      <Border Background="#1A62D0E8" BorderBrush="#3362D0E8" BorderThickness="1" CornerRadius="8,8,2,8" Padding="10,7,10,8">
        <StackPanel>
          <TextBlock FontSize="11" Foreground="#62D0E8" Text="{Binding At.LocalDateTime, StringFormat='Raven · {0:HH:mm}'}" />
          <TextBlock FontSize="13" Foreground="#E5E7EB" TextWrapping="Wrap" Margin="0,3,0,0" Text="{Binding Text}" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ActionEntry" DataType="{x:Type raven:RavenLogEntry}">
      <Border x:Name="Card" HorizontalAlignment="Left" Background="#0F172A" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6"
              Padding="8,4,10,5" Margin="8,0,0,0" ToolTip="What Raven looked at">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="Glyph" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="#62D0E8" Text="&#xE721;"
                     VerticalAlignment="Center" Margin="0,1,7,0" />
          <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#D1D5DB" Text="{Binding Text}" VerticalAlignment="Center" />
          <TextBlock x:Name="Detail" FontSize="12" Foreground="#9CA3AF" Text="{Binding Detail, StringFormat=' · {0}'}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" MaxWidth="180" ToolTip="{Binding Detail}" />
          <TextBlock x:Name="FailedText" FontSize="12" Foreground="#F59E0B" Text=" · failed" VerticalAlignment="Center" Visibility="Collapsed" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
          <Setter TargetName="Detail" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Failed}" Value="True">
          <Setter TargetName="Glyph" Property="Foreground" Value="#F59E0B" />
          <Setter TargetName="FailedText" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <!-- A digest card: what the chats did, one line per chat; a click shows its tile in the Yard. -->
    <DataTemplate x:Key="NewsEntry" DataType="{x:Type raven:RavenLogEntry}">
      <Border Background="#0F172A" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="10,6,10,7">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="{StaticResource Icons}" FontSize="11" Foreground="#62D0E8" Text="&#xE789;" VerticalAlignment="Center" Margin="0,1,7,0" />
            <TextBlock FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center">
              <Run Text="{Binding Text, Mode=OneWay}" /><Run Text="{Binding At.LocalDateTime, Mode=OneWay, StringFormat=' · {0:HH:mm}'}" />
            </TextBlock>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Lines}" Margin="0,4,0,0" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type raven:ChatNewsLine}">
                <Button Command="{Binding DataContext.ShowNewsTileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" Cursor="Hand" ToolTip="Show its tile in the Yard" HorizontalContentAlignment="Left"
                        AutomationProperties.Name="{Binding Text}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="4,2">
                        <TextBlock x:Name="Line" FontSize="12" Foreground="#D1D5DB" TextWrapping="Wrap" Text="{Binding Text}" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Row" Property="Background" Value="#1F2937" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Stale}" Value="True">
                          <Setter TargetName="Line" Property="Foreground" Value="#6B7280" />
                        </DataTrigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
    <!-- A button on a question card: Send, Answer in VS Code. -->
    <Style x:Key="CardButton" TargetType="Button">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#D1D5DB" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="5" Padding="10,3,10,4">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#374151" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Box" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- A chat's question: each question with its options to click. A card of one question that takes one option is answered by
         the click; any other is sent with Send. Answer in VS Code leaves it to the chat's tab. Answered or let go, it says how. -->
    <DataTemplate x:Key="QuestionEntry" DataType="{x:Type raven:RavenLogEntry}">
      <Border x:Name="Card" Background="#0F172A" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="10,6,10,8">
        <StackPanel DataContext="{Binding Ask}">
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="{StaticResource Icons}" FontSize="11" Foreground="#F59E0B" Text="&#xE897;" VerticalAlignment="Center" Margin="0,1,7,0" />
            <TextBlock FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="250">
              <Run Text="{Binding Chat, Mode=OneWay}" /><Run Text=" asks" />
            </TextBlock>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Questions}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type raven:ChatQuestionView}">
                <StackPanel Margin="0,6,0,0">
                  <TextBlock FontSize="13" Foreground="#E5E7EB" TextWrapping="Wrap" Text="{Binding Text}" />
                  <ItemsControl ItemsSource="{Binding Options}" Focusable="False" Margin="0,5,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type raven:ChatOptionView}">
                        <Button Command="{Binding DataContext.ChooseOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" IsEnabled="{Binding Question.Card.IsOpen}" Cursor="Hand" Margin="0,0,0,4"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Label}" FocusVisualStyle="{StaticResource FocusRing}">
                          <Button.Template>
                            <ControlTemplate TargetType="Button">
                              <Border x:Name="Box" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="5" Padding="8,4,8,5">
                                <StackPanel>
                                  <TextBlock FontSize="12" Foreground="#E5E7EB" TextWrapping="Wrap" Text="{Binding Label}" />
                                  <TextBlock x:Name="Description" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" Text="{Binding Description}" />
                                </StackPanel>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="Box" Property="Background" Value="#374151" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsChosen}" Value="True">
                                  <Setter TargetName="Box" Property="Background" Value="#2662D0E8" />
                                  <Setter TargetName="Box" Property="BorderBrush" Value="#62D0E8" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                  <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                  <Setter TargetName="Box" Property="Opacity" Value="0.6" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Button.Template>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel x:Name="Buttons" Orientation="Horizontal" Margin="0,4,0,0">
            <Button Style="{StaticResource CardButton}" Content="Send" IsEnabled="{Binding CanSend}"
                    Visibility="{Binding NeedsSend, Converter={StaticResource BoolVisible}}"
                    Command="{Binding DataContext.SendAnswersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                    ToolTip="Send the chosen options to the chat" />
            <Button Style="{StaticResource CardButton}" Content="Answer in VS Code"
                    Command="{Binding DataContext.AnswerInVsCodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                    ToolTip="Leave the question to the chat's VS Code tab, which asks it there" />
          </StackPanel>
          <TextBlock x:Name="Outcome" FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Text="{Binding Outcome}" Margin="0,4,0,0" Visibility="Collapsed" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Ask.IsOpen}" Value="False">
          <Setter TargetName="Card" Property="BorderBrush" Value="#1F2937" />
          <Setter TargetName="Buttons" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Outcome" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <!-- A chat's permission prompt: what it wants to do (the command, the file, the URL), with Allow and Deny. VS Code shows its own
         prompt meanwhile; answered there, or let go, the card says how it ended. -->
    <DataTemplate x:Key="PermissionEntry" DataType="{x:Type raven:RavenLogEntry}">
      <Border x:Name="Card" Background="#0F172A" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="10,6,10,8">
        <StackPanel DataContext="{Binding Ask}">
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="{StaticResource Icons}" FontSize="11" Foreground="#F59E0B" Text="&#xE83D;" VerticalAlignment="Center" Margin="0,1,7,0" />
            <TextBlock FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="250"
                       Text="{Binding Chat}" />
          </StackPanel>
          <TextBlock FontSize="13" Foreground="#E5E7EB" TextWrapping="Wrap" Text="{Binding WantsLine}" Margin="0,6,0,0" />
          <!-- What the rules found risky; Raven always says it too. -->
          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#F87171" TextWrapping="Wrap" Text="{Binding RiskLine, Mode=OneWay}" Margin="0,3,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding RiskLine}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <!-- All of it, never cut: Allow allows all of it. A long one scrolls. -->
          <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,6,0,0">
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#E5E7EB" TextWrapping="Wrap"
                         Text="{Binding Permission.Subject, Mode=OneWay}" AutomationProperties.Name="{Binding Permission.Subject, Mode=OneWay}" />
            </ScrollViewer>
          </Border>
          <!-- An edit's change, a file's content: what the file name alone does not say. -->
          <Border Background="#0B1220" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,4,0,0">
            <Border.Style>
              <Style TargetType="Border">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Permission.Details}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"
                         Text="{Binding Permission.Details, Mode=OneWay}" AutomationProperties.Name="{Binding Permission.Details, Mode=OneWay}" />
            </ScrollViewer>
          </Border>
          <!-- An allow proposed by voice: the user's next yes, found by the app, allows it (#108). -->
          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FBBF24" TextWrapping="Wrap" Text="{x:Static raven:ChatAskCard.AwaitsYesLine}" Margin="0,6,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding AwaitsYes}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <StackPanel x:Name="Buttons" Orientation="Horizontal" Margin="0,6,0,0">
            <Button Style="{StaticResource CardButton}" Content="Allow"
                    Command="{Binding DataContext.AllowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                    ToolTip="Let the chat do this once; it carries on" />
            <Button Style="{StaticResource CardButton}" Content="Deny"
                    Command="{Binding DataContext.DenyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                    ToolTip="Don't let it; the chat is told and carries on without it" />
            <Button Style="{StaticResource CardButton}" Content="Answer in VS Code"
                    Command="{Binding DataContext.AnswerInVsCodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                    ToolTip="Leave it to the prompt in the chat's VS Code tab" />
          </StackPanel>
          <!-- What Claude Code suggests to allow for good, one button each; by click only (#109). None when it suggests none. -->
          <ItemsControl x:Name="Always" ItemsSource="{Binding Suggestions}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type raven:ChatSuggestionView}">
                <Button Style="{StaticResource CardButton}" HorizontalAlignment="Left" Margin="0,5,0,0"
                        Command="{Binding DataContext.AlwaysAllowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                        ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Text}">
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="Outcome" FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Text="{Binding Outcome}" Margin="0,4,0,0" Visibility="Collapsed" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Ask.IsOpen}" Value="False">
          <Setter TargetName="Card" Property="BorderBrush" Value="#1F2937" />
          <Setter TargetName="Buttons" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Always" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Outcome" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <!-- An entry of the chat list: the selected one lit, Activity set apart at the bottom. -->
    <Style x:Key="ChatListItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
      <Setter Property="AutomationProperties.ItemStatus" Value="{Binding Status}" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Back" Background="Transparent" CornerRadius="7" Padding="7,6">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="#111A2B" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Back" Property="Background" Value="#16213A" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsActivity}" Value="True">
          <Setter Property="Margin" Value="0,14,0,0" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Activity: one line per entry of any chat, tagged with the chat's number, a card's outcome below it; no buttons. -->
    <DataTemplate x:Key="ActivityEntry" DataType="{x:Type raven:RavenLogEntry}">
      <Grid Margin="2,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="20" Height="20" CornerRadius="10" BorderThickness="1" BorderBrush="#374151" VerticalAlignment="Top" Margin="0,0,8,0"
                ToolTip="{Binding Chat.Label}">
          <TextBlock Text="{Binding Chat.Tag}" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1">
          <TextBlock FontSize="12.5" Foreground="#D1D5DB" TextWrapping="Wrap">
            <Run Text="{Binding At.LocalDateTime, StringFormat='HH:mm', Mode=OneWay}" Foreground="#6B7280" />
            <Run Text="{Binding ActivityLine, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Text="{Binding Ask.Outcome}" FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Ask.Outcome}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="NoteEntry" DataType="{x:Type raven:RavenLogEntry}">
      <TextBlock FontSize="13" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="2,0" Text="{Binding Text}" />
    </DataTemplate>
    <DataTemplate x:Key="WarningEntry" DataType="{x:Type raven:RavenLogEntry}">
      <Grid Margin="2,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock FontFamily="{StaticResource Icons}" FontSize="13" Foreground="#F59E0B" Text="&#xE7BA;" Margin="0,2,8,0" VerticalAlignment="Top" />
        <TextBlock Grid.Column="1" FontSize="13" Foreground="#F59E0B" TextWrapping="Wrap" Text="{Binding Text}" />
      </Grid>
    </DataTemplate>

    <!-- A chat's number on its dot, with its marks: the chat list's rows and the collapsed strip's numbers. -->
    <DataTemplate x:Key="ChatNumber" DataType="{x:Type raven:RavenChat}">
      <Grid VerticalAlignment="Center">
        <Border x:Name="Dot" Width="24" Height="24" CornerRadius="12" BorderThickness="1" BorderBrush="#4B5563">
          <Grid>
            <TextBlock Text="{Binding Tag}" FontSize="12" FontWeight="SemiBold" Foreground="#D1D5DB"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <!-- Activity has no number: a list of everything. -->
            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="#9CA3AF"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsActivity, Converter={StaticResource BoolVisible}}" />
          </Grid>
        </Border>
        <!--
          A card waits for the user: an amber ring until it is answered, blinking gently until the chat is opened.
          With Windows' "Show animations" off it stays steady (SystemParameters tells its bindings when it changes).
        -->
        <Border Margin="-3" CornerRadius="15" BorderThickness="2" BorderBrush="#F59E0B" IsHitTestVisible="False"
                Visibility="{Binding IsWaiting, Converter={StaticResource BoolVisible}}">
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsWaitingUnseen}" Value="True" />
                    <Condition Binding="{Binding Path=(SystemParameters.ClientAreaAnimation)}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <MultiDataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Blink">
                      <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.8" />
                      </Storyboard>
                    </BeginStoryboard>
                  </MultiDataTrigger.EnterActions>
                  <MultiDataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Blink" />
                  </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
        </Border>
        <!-- The chat failed: a red mark at the lower left until it is opened. -->
        <Ellipse Width="9" Height="9" Fill="#EF4444" Stroke="#0B1220" StrokeThickness="1.5" IsHitTestVisible="False"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-3,0,0,-3"
                 Visibility="{Binding HasFailed, Converter={StaticResource BoolVisible}}" />
        <!--
          Work goes on in it (#182): Raven answers there, or a Claude chat of its window works. A green dot at the lower
          right, breathing; steady with Windows' "Show animations" off.
        -->
        <Ellipse Width="9" Height="9" Fill="#22C55E" Stroke="#0B1220" StrokeThickness="1.5" IsHitTestVisible="False"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                 Visibility="{Binding IsWorking, Converter={StaticResource BoolVisible}}">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.ClientAreaAnimation)}" Value="True">
                  <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Breathe">
                      <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.9" />
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.EnterActions>
                  <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Breathe" />
                  </DataTrigger.ExitActions>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <!-- Lines that came while the user was elsewhere: their count at the upper right. -->
        <Border MinWidth="15" Height="15" CornerRadius="7.5" Background="#3B82F6" Padding="3,0" IsHitTestVisible="False"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-7,0" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform>
            <ScaleTransform />
          </Border.RenderTransform>
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Unread}" Value="0">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <!-- A line just came (#173): three beats, then steady. Steady with Windows' "Show animations" off. -->
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsNewsPulsing}" Value="True" />
                    <Condition Binding="{Binding Path=(SystemParameters.ClientAreaAnimation)}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <MultiDataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Pulse">
                      <Storyboard RepeatBehavior="3x">
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         From="1" To="1.45" Duration="0:0:0.4" AutoReverse="True" />
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         From="1" To="1.45" Duration="0:0:0.4" AutoReverse="True" />
                      </Storyboard>
                    </BeginStoryboard>
                  </MultiDataTrigger.EnterActions>
                  <MultiDataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Pulse" />
                  </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding UnreadText}" FontSize="9.5" FontWeight="Bold" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <!-- A window's chat wears its tile's colour. -->
        <DataTrigger Binding="{Binding Tile, Converter={StaticResource IsNull}}" Value="False">
          <Setter TargetName="Dot" Property="BorderBrush" Value="{Binding Tile.AccentColor, Converter={StaticResource HexBrush}}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!--
      The panel's device pickers: a name shortened with "…" where the panel is too narrow (whole in the tooltip), read out
      and typed to by that name, not the device record's text.
    -->
    <Style x:Key="DevicePicker" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="TextSearch.TextPath" Value="Name" />
      <Setter Property="ItemTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,1,0">
    <Grid>
      <!-- Open: Raven and the chat list on the left, the chosen chat on the right at 320 px. In the Cab the left side folds
           to a rail of the orb, the mic and the chats' numbers, so VS Code keeps its width. -->
      <Grid Visibility="{Binding IsOpen, Converter={StaticResource BoolVisible}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="{x:Static shell:NarrowLayout.RavenChatColumn}" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0B111E" BorderBrush="#1F2937" BorderThickness="0,0,1,0">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Width" Value="{x:Static shell:NarrowLayout.RavenList}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsListFolded}" Value="True">
                  <Setter Property="Width" Value="{x:Static shell:NarrowLayout.RavenListFolded}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Raven itself, the same whichever chat is chosen. -->
            <StackPanel Grid.Row="0" Margin="14,12,14,12" Visibility="{Binding IsListFolded, Converter={StaticResource BoolCollapsed}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Raven" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Style="{StaticResource StateText}" Margin="10,1,0,0" />
                <Button Grid.Column="2" Style="{StaticResource MuteButton}" Command="{Binding ToggleMuteCommand}" Margin="0,0,4,0" />
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE76B;" Command="{Binding TogglePanelCommand}"
                        ToolTip="Collapse (Ctrl+Alt+J)" AutomationProperties.Name="Collapse Raven" />
              </Grid>

              <!-- Animates only while it is seen: idle breathing pauses while the window is inactive or minimised. -->
              <raven:RavenOrb Width="120" Height="120" Margin="0,8,0,2" HorizontalAlignment="Center" IsAnimating="True"
                              State="{Binding State}" Level="{Binding Level}" />

              <TextBlock Text="{Binding Caption}" FontSize="12" Foreground="#9CA3AF" TextAlignment="Center" TextWrapping="Wrap"
                         MinHeight="32" Margin="0,0,0,8" />

              <Button x:Name="MicButton" Style="{StaticResource MicButton}" HorizontalAlignment="Center"
                      PreviewMouseLeftButtonDown="OnMicDown" PreviewMouseLeftButtonUp="OnMicUp" LostMouseCapture="OnMicCaptureLost"
                      PreviewKeyDown="OnMicKey" />
              <!-- Push to talk or Open mic: two radio buttons styled as one switch. They show the mode in effect, and
                   every click is the user's choice, one on the half already checked too (after a fallback), and so is a half
                   checked any other way. UI Automation's Select clicks the half (MicModeRadioButton). -->
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <raven:MicModeRadioButton Style="{StaticResource ModeSwitch}" Content="Push to talk" AutomationProperties.Name="Push to talk mode"
                             IsChecked="{Binding MicMode, Mode=OneWay, Converter={StaticResource EnumIs}, ConverterParameter=PushToTalk}"
                             Tag="{x:Static raven:MicMode.PushToTalk}" Checked="OnModeChecked" Click="OnModeClick" />
                <raven:MicModeRadioButton Style="{StaticResource ModeSwitch}" Content="Open mic" AutomationProperties.Name="Open mic mode"
                             IsChecked="{Binding MicMode, Mode=OneWay, Converter={StaticResource EnumIs}, ConverterParameter=OpenMic}"
                             Tag="{x:Static raven:MicMode.OpenMic}" Checked="OnModeChecked" Click="OnModeClick" />
              </StackPanel>

              <!-- The mic heard, to try another where you talk: a pick here is not saved, Settings → Listening keeps the default. -->
              <TextBlock Text="Mic" FontSize="11" Foreground="#9CA3AF" Margin="0,12,0,4" />
              <ComboBox ItemsSource="{Binding Microphones}" Style="{StaticResource DevicePicker}" SelectedItem="{Binding SelectedMicrophone}"
                        FontSize="13" HorizontalAlignment="Stretch" AutomationProperties.Name="Microphone"
                        ToolTip="{Binding SelectedMicrophone.Name}" />
              <Border Height="4" CornerRadius="2" Background="#1F2937" Margin="0,8,0,0" ClipToBounds="True" ToolTip="Mic level">
                <!-- The level is Raven's voice while it speaks: not the mic's. -->
                <Border Background="#62D0E8" CornerRadius="2" RenderTransformOrigin="0,0.5">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Speaking">
                          <Setter Property="Visibility" Value="Hidden" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Border.RenderTransform>
                    <ScaleTransform ScaleX="{Binding Level}" />
                  </Border.RenderTransform>
                </Border>
              </Border>
              <TextBlock Text="{Binding MicTrialNote}" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,6,0,0"
                         Visibility="{Binding MicTrialNote, Converter={StaticResource NullToCollapsed}}" />

              <!-- The output Raven speaks on, to try another: as with the mic, Settings → Voice keeps the default. -->
              <StackPanel DataContext="{Binding Speakers}" Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="Speaker" FontSize="11" Foreground="#9CA3AF" Margin="0,10,0,4" />
                <ComboBox ItemsSource="{Binding Speakers}" Style="{StaticResource DevicePicker}" SelectedItem="{Binding SelectedSpeaker}"
                          FontSize="13" HorizontalAlignment="Stretch" AutomationProperties.Name="Speaker"
                          ToolTip="{Binding SelectedSpeaker.Name}" />
                <TextBlock Text="{Binding TrialNote}" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding TrialNote, Converter={StaticResource NullToCollapsed}}" />
              </StackPanel>

              <!-- What a chat Raven starts runs with: set by voice ("from now on Opus") or in Settings → Brain & chats, which a click opens. -->
              <Button Margin="0,12,0,0" HorizontalAlignment="Center" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}"
                      Command="{Binding DataContext.OpenSettingsAtCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{x:Static settings:SettingsPage.Brain}" AutomationProperties.Name="New chats: open Brain and chats settings"
                      ToolTip="New chats Raven starts run with these. Say &quot;from now on …&quot; to change them, or click to change them in Settings.">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <StackPanel Background="Transparent">
                      <TextBlock Text="New chats" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,0,0,4" />
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border x:Name="ModelChip" Style="{StaticResource Chip}">
                          <TextBlock Text="{Binding ChatModelChip}" FontSize="11" Foreground="#D1D5DB" AutomationProperties.Name="Chat model" />
                        </Border>
                        <Border x:Name="EffortChip" Style="{StaticResource Chip}">
                          <TextBlock Text="{Binding ChatEffortChip}" FontSize="11" Foreground="#D1D5DB" AutomationProperties.Name="Chat effort" />
                        </Border>
                      </StackPanel>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ModelChip" Property="BorderBrush" Value="#62D0E8" />
                        <Setter TargetName="EffortChip" Property="BorderBrush" Value="#62D0E8" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </StackPanel>

            <!-- Folded (the Cab, or Settings on a narrow window): the orb and the mic, as on the collapsed rail. -->
            <StackPanel Grid.Row="0" Margin="0,14,0,6" HorizontalAlignment="Center"
                        Visibility="{Binding IsListFolded, Converter={StaticResource BoolVisible}}">
              <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Command="{Binding TogglePanelCommand}" HorizontalAlignment="Center"
                      ToolTip="Collapse (Ctrl+Alt+J)" AutomationProperties.Name="Collapse Raven" />
              <raven:RavenOrb Width="34" Height="34" Margin="0,14,0,0" HorizontalAlignment="Center" IsAnimating="True"
                              State="{Binding State}" Level="{Binding Level}" />
              <Button Style="{StaticResource MicButton}" Width="38" Height="38" FontSize="16" Margin="0,14,0,0" HorizontalAlignment="Center"
                      PreviewMouseLeftButtonDown="OnMicDown" PreviewMouseLeftButtonUp="OnMicUp" LostMouseCapture="OnMicCaptureLost"
                      PreviewKeyDown="OnMicKey" />
            </StackPanel>

            <!-- The chats: selecting one only shows it, it never opens its VS Code. -->
            <ListBox x:Name="ChatList" Grid.Row="1" ItemsSource="{Binding Chats}" SelectedItem="{Binding SelectedChat, Mode=TwoWay}"
                     Background="Transparent" BorderBrush="#1F2937" BorderThickness="0,1,0,0" Padding="6,10,6,10"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Raven chats" ItemContainerStyle="{StaticResource ChatListItem}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type raven:RavenChat}">
                  <Grid x:Name="Row" ToolTip="{Binding Tip}" Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- A window chat's menu: mute or unmute it (#153). -->
                    <Grid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{Binding MuteText}" Command="{Binding ToggleMuteCommand}" />
                      </ContextMenu>
                    </Grid.ContextMenu>
                    <!-- The number's dot and its marks: they show on the folded list in the Cab, and on the collapsed strip. -->
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ChatNumber}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ChatName" Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="#E5E7EB" Margin="10,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="ChatMute" Grid.Column="2" Style="{StaticResource ChatMuteButton}" Margin="4,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding DataContext.IsListFolded, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                      <Setter TargetName="ChatName" Property="Visibility" Value="Collapsed" />
                      <Setter TargetName="ChatMute" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <!-- Chat 0 and Activity have no mute of their own: no menu. -->
                    <DataTrigger Binding="{Binding CanMute}" Value="False">
                      <Setter TargetName="Row" Property="ContextMenu" Value="{x:Null}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The chosen chat: its window by number and name, and where that window's repositories stand, as its tile shows them. -->
        <Border Grid.Row="0" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="14,12,14,10">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Width="24" Height="24" CornerRadius="12" BorderThickness="1" VerticalAlignment="Center">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{Binding SelectedChat.Tile.AccentColor, Converter={StaticResource HexBrush}}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SelectedChat.Tile}" Value="{x:Null}">
                        <Setter Property="BorderBrush" Value="#4B5563" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Grid>
                  <TextBlock Text="{Binding SelectedChat.Tag}" FontSize="12" FontWeight="SemiBold" Foreground="#E5E7EB"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <TextBlock Text="&#xE81C;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="#9CA3AF"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding SelectedChat.IsActivity, Converter={StaticResource BoolVisible}}" />
                </Grid>
              </Border>
              <TextBlock Text="{Binding SelectedChat.Name}" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="10,0,0,0"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="250" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding SelectedChat.Tile.GitLines}" ItemTemplate="{StaticResource GitLineTemplate}"
                          Margin="0,8,0,0" Foreground="#D1D5DB" FontSize="12" Focusable="False" />
            <TextBlock Text="{Binding SelectedChat.Subtitle}" FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding SelectedChat.Subtitle, Converter={StaticResource NullToCollapsed}}" />
          </StackPanel>
        </Border>

        <Grid Grid.Row="1">
          <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                        ScrollChanged="OnLogScrolled">
            <ItemsControl ItemsSource="{Binding Shown}" Margin="14,12,14,4" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type raven:RavenLogEntry}">
                  <ContentControl Content="{Binding}" Focusable="False" Margin="0,0,0,10">
                    <ContentControl.Style>
                      <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource NoteEntry}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Kind}" Value="You">
                            <Setter Property="ContentTemplate" Value="{StaticResource YouEntry}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Kind}" Value="Warning">
                            <Setter Property="ContentTemplate" Value="{StaticResource WarningEntry}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Kind}" Value="Raven">
                            <Setter Property="ContentTemplate" Value="{StaticResource RavenEntry}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Kind}" Value="Action">
                            <Setter Property="ContentTemplate" Value="{StaticResource ActionEntry}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Kind}" Value="News">
                            <Setter Property="ContentTemplate" Value="{StaticResource NewsEntry}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Kind}" Value="Question">
                            <Setter Property="ContentTemplate" Value="{StaticResource QuestionEntry}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Kind}" Value="Permission">
                            <Setter Property="ContentTemplate" Value="{StaticResource PermissionEntry}" />
                          </DataTrigger>
                          <!-- Last, so it wins: Activity shows every entry as a line, without buttons. -->
                          <DataTrigger Binding="{Binding DataContext.SelectedChat.IsActivity, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                            <Setter Property="ContentTemplate" Value="{StaticResource ActivityEntry}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ContentControl.Style>
                  </ContentControl>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Text="Ask about your workspaces and chats, or start one: &#x201C;What's waiting on me?&#x201D; &#x201C;For CodeSwitchX, add a dark mode.&#x201D;" FontSize="13" Foreground="#4B5563"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="24,0"
                     IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Shown.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#1F2937" BorderThickness="0,1,0,0" Padding="14,10,14,12">
          <Grid>
            <TextBox x:Name="TypeBox" Text="{Binding TypedText, UpdateSourceTrigger=PropertyChanged}" FontSize="13"
                     AutomationProperties.Name="Type instead of talking">
              <TextBox.InputBindings>
                <KeyBinding Key="Return" Command="{Binding SubmitTypedCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <TextBlock Text="{Binding TypePrompt}" FontSize="13" Foreground="#6B7280" IsHitTestVisible="False"
                       VerticalAlignment="Center" Margin="12,0,12,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding TypedText}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Border>
        </Grid>
      </Grid>

      <!-- Collapsed: a 58 px rail that keeps the orb, the mic and the chats' numbers (#173). -->
      <Grid Visibility="{Binding IsOpen, Converter={StaticResource BoolCollapsed}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Center" Margin="0,14,0,0">
          <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Command="{Binding TogglePanelCommand}"
                  ToolTip="Expand Raven (Ctrl+Alt+J)" AutomationProperties.Name="Expand Raven" HorizontalAlignment="Center" />
          <raven:RavenOrb Width="34" Height="34" Margin="0,16,0,0" HorizontalAlignment="Center"
                          State="{Binding State}" Level="{Binding Level}">
            <raven:RavenOrb.Style>
              <!-- At this size the idle breath is under a pixel: only listening, transcribing, thinking and speaking animate here. -->
              <Style TargetType="raven:RavenOrb">
                <Setter Property="IsAnimating" Value="True" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding State}" Value="Idle">
                    <Setter Property="IsAnimating" Value="False" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding State}" Value="AttendingPaused">
                    <Setter Property="IsAnimating" Value="False" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </raven:RavenOrb.Style>
          </raven:RavenOrb>
          <Button Style="{StaticResource MicButton}" Width="38" Height="38" FontSize="16" Margin="0,16,0,0" HorizontalAlignment="Center"
                  PreviewMouseLeftButtonDown="OnMicDown" PreviewMouseLeftButtonUp="OnMicUp" LostMouseCapture="OnMicCaptureLost"
                  PreviewKeyDown="OnMicKey" />
        </StackPanel>

        <!-- Each chat's number with its marks; a click opens Raven on that chat. More than fit scroll under the mic. -->
        <ScrollViewer Grid.Row="1" Margin="0,14,0,10" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
          <ItemsControl ItemsSource="{Binding Chats}" Focusable="False" AutomationProperties.Name="Raven chats, collapsed">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type raven:RavenChat}">
                <Button Command="{Binding DataContext.OpenChatCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}" Cursor="Hand" HorizontalAlignment="Center" Margin="0,3"
                        ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Tip, StringFormat='Show Raven chat {0}'}"
                        FocusVisualStyle="{StaticResource RoundFocusRing}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Hover" Width="40" Height="40" CornerRadius="20" Background="Transparent">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ChatNumber}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Hover" Property="Background" Value="#1F2937" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</UserControl>
