<Application x:Class="CodeSwitchX.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:CodeSwitchX.UI.Infrastructure"
             xmlns:yard="clr-namespace:CodeSwitchX.UI.Yard"
             ShutdownMode="OnMainWindowClose"
             ThemeMode="Dark">
  <Application.Resources>
    <infra:SessionStateToBrushConverter x:Key="StateBrush" />
    <infra:HexToBrushConverter x:Key="HexBrush" />
    <infra:PressureToBrushConverter x:Key="PressureBrush" />
    <infra:CacheWarmthToBrushConverter x:Key="CacheBrush" />
    <infra:HostStateToTextConverter x:Key="HostStateText" />
    <infra:EnumEqualsToVisibilityConverter x:Key="EnumVisible" />
    <infra:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <BooleanToVisibilityConverter x:Key="BoolVisible" />
    <infra:TrueToCollapsedConverter x:Key="BoolCollapsed" />
    <infra:ModelDotToBrushConverter x:Key="DotBrush" />
    <infra:InvertBoolConverter x:Key="InvertBool" />
    <infra:IsNullConverter x:Key="IsNull" />
    <infra:SameToVisibleConverter x:Key="SameVisible" />
    <!-- The pills' colours (#335), defined once: the GitHub panel's tab in front and its merge strip use them too (#416). -->
    <SolidColorBrush x:Key="IssuePillText" Color="#B9CDF0" />
    <SolidColorBrush x:Key="IssuePillBack" Color="#3A4250" />
    <SolidColorBrush x:Key="IssuePillBorder" Color="#566378" />
    <SolidColorBrush x:Key="PullRequestPillText" Color="#A6E3E9" />
    <SolidColorBrush x:Key="PullRequestPillBack" Color="#2D464B" />
    <SolidColorBrush x:Key="PullRequestPillBorder" Color="#4B6F76" />
    <yard:GitHubLabelBrushConverter x:Key="LabelBrush" />
    <!-- The issue and pull request pills on a tile's git line (#335); each button takes its kind's brushes from above (#416). -->
    <Style x:Key="GitHubPillButton" TargetType="Button">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="yard:GitHubPillPreview.IsEnabled" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Pill" CornerRadius="8" Padding="6,0,7,1" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Pill" Property="Opacity" Value="0.85" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding}" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- One row of a pill's preview: number and title, then labels, branch, author and age. -->
    <DataTemplate x:Key="GitHubRowTemplate" DataType="{x:Type yard:GitHubRow}">
      <StackPanel Margin="0,4">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="{Binding NumberText}" Opacity="0.55" Margin="0,0,6,0" />
          <TextBlock Text="{Binding Item.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
        </DockPanel>
        <WrapPanel Margin="0,2,0,0" VerticalAlignment="Center">
          <!-- not focusable: inside a row's button it would be a Tab stop of its own -->
          <ItemsControl ItemsSource="{Binding Item.Labels}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="8" Padding="6,0,6,1" Margin="0,0,4,2" BorderThickness="1"
                        Background="{Binding Color, Converter={StaticResource LabelBrush}}"
                        BorderBrush="{Binding Color, Converter={StaticResource LabelBrush}, ConverterParameter=border}">
                  <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{Binding Color, Converter={StaticResource LabelBrush}, ConverterParameter=text}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Item.Branch}" FontFamily="Consolas" FontSize="11" Opacity="0.7" MaxWidth="180" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                     Visibility="{Binding Item.Branch, Converter={StaticResource NullToCollapsed}}" />
          <TextBlock Text="{Binding ByText}" FontSize="11" Opacity="0.7" Margin="0,0,8,0"
                     Visibility="{Binding ByText, Converter={StaticResource NullToCollapsed}}" />
          <TextBlock Text="{Binding AgeText}" FontSize="11" Opacity="0.55" />
        </WrapPanel>
      </StackPanel>
    </DataTemplate>
    <!-- A repository's line as it reads: on a tile, and in the header of its Raven chat. -->
    <DataTemplate x:Key="GitLineContent" DataType="{x:Type yard:GitLine}">
      <!-- the pill sits at the line's right edge, so the pills of every line and every tile line up; the folder and the
           branch share what is left, a long folder name at most 120 wide, so the pills stay whole. The line's tooltip is on its
           parts, not on the Grid: a pill has none above it, so the preview is the only thing over it -->
      <Grid Margin="0,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="&#xE9F5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" Opacity="0.75" ToolTip="{Binding ToolTipText}" />
        <DockPanel Grid.Column="1" ToolTip="{Binding ToolTipText}">
          <TextBlock DockPanel.Dock="Left" Text="{Binding Folder}" MaxWidth="120" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.75" />
          <TextBlock DockPanel.Dock="Left" Text="{Binding Separator}" VerticalAlignment="Center" Opacity="0.75" />
          <TextBlock Text="{Binding BranchText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.75" />
        </DockPanel>
        <!-- the issue and pull request pills (#335): on a tile only. A click is the pill's own, not the tile's. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal"
                    Visibility="{Binding Path=(yard:GitPills.IsShown), RelativeSource={RelativeSource Self}, Converter={StaticResource BoolVisible}}">
          <Button DataContext="{Binding Issues}" Style="{StaticResource GitHubPillButton}"
                  Foreground="{StaticResource IssuePillText}" Background="{StaticResource IssuePillBack}" BorderBrush="{StaticResource IssuePillBorder}"
                  Command="{Binding DataContext.OpenGitHubListCommand, RelativeSource={RelativeSource AncestorType=yard:YardView}}" CommandParameter="{Binding}"
                  AutomationProperties.Name="{Binding AutomationName}">
            <StackPanel Orientation="Horizontal">
              <Canvas Width="12" Height="12" VerticalAlignment="Center" Margin="0,1,4,0">
                <Ellipse Canvas.Left="1" Canvas.Top="1" Width="10" Height="10" Stroke="{StaticResource IssuePillText}" StrokeThickness="1.3" />
                <Ellipse Canvas.Left="4.5" Canvas.Top="4.5" Width="3" Height="3" Fill="{StaticResource IssuePillText}" />
              </Canvas>
              <TextBlock Text="{Binding Count}" />
            </StackPanel>
          </Button>
          <Button DataContext="{Binding PullRequests}" Style="{StaticResource GitHubPillButton}"
                  Foreground="{StaticResource PullRequestPillText}" Background="{StaticResource PullRequestPillBack}" BorderBrush="{StaticResource PullRequestPillBorder}"
                  Command="{Binding DataContext.OpenGitHubListCommand, RelativeSource={RelativeSource AncestorType=yard:YardView}}" CommandParameter="{Binding}"
                  AutomationProperties.Name="{Binding AutomationName}">
            <StackPanel Orientation="Horizontal">
              <Canvas Width="12" Height="12" VerticalAlignment="Center" Margin="0,1,4,0">
                <Ellipse Canvas.Left="1" Canvas.Top="1" Width="3" Height="3" Stroke="{StaticResource PullRequestPillText}" StrokeThickness="1.2" />
                <Ellipse Canvas.Left="1" Canvas.Top="8" Width="3" Height="3" Stroke="{StaticResource PullRequestPillText}" StrokeThickness="1.2" />
                <Ellipse Canvas.Left="8" Canvas.Top="8" Width="3" Height="3" Stroke="{StaticResource PullRequestPillText}" StrokeThickness="1.2" />
                <Path Data="M2.5,4 V8 M9.5,8 V5 Q9.5,3.5 8,3.5 H6" Stroke="{StaticResource PullRequestPillText}" StrokeThickness="1.2" />
              </Canvas>
              <TextBlock Text="{Binding Count}" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Border Grid.Column="3" CornerRadius="8" Padding="7,0,7,1" Margin="8,0,0,0" VerticalAlignment="Center" BorderThickness="1" ToolTip="{Binding ToolTipText}">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="#26F59E0B" />
              <Setter Property="BorderBrush" Value="#80F59E0B" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding GitStateLabel}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DirtyCount}" Value="0">
                  <Setter Property="Background" Value="#2622C55E" />
                  <Setter Property="BorderBrush" Value="#8022C55E" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding GitStateLabel}" FontSize="11" FontWeight="SemiBold">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F59E0B" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DirtyCount}" Value="0">
                    <Setter Property="Foreground" Value="#22C55E" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Border>
      </Grid>
    </DataTemplate>
    <!-- A tile's line on GitHub (#406): the whole line is one button that opens the repository's panel, lit under the pointer. The
         border's thickness never changes and its negative margin gives back what it and the padding take, so the line has the room
         of a plain one and nothing moves. No tooltip: a pill has none above it (#335). Stretched against the theme's Button style
         (Left, Center): the pills stay at the line's right edge and a click anywhere on the line is the line's. -->
    <DataTemplate x:Key="GitLineButton" DataType="{x:Type yard:GitLine}">
      <Button Content="{Binding}" ContentTemplate="{StaticResource GitLineContent}" Cursor="Hand" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Command="{Binding DataContext.OpenGitHubLineCommand, RelativeSource={RelativeSource AncestorType=yard:YardView}}" CommandParameter="{Binding}"
              AutomationProperties.Name="{Binding OpenGitHubText}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Back" Margin="-4,-1" Padding="3,0" BorderThickness="1" CornerRadius="5" Background="Transparent" BorderBrush="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="#3D4A5C" />
                <Setter TargetName="Back" Property="BorderBrush" Value="#6B85A8" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </DataTemplate>
    <!-- A repository's line: a button on a tile when it is on GitHub, plain text otherwise and in Raven's chat header, where a
         click must still reach the tile or the header. -->
    <DataTemplate x:Key="GitLineTemplate" DataType="{x:Type yard:GitLine}">
      <ContentControl Content="{Binding}" Focusable="False" IsTabStop="False">
        <ContentControl.Style>
          <Style TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource GitLineButton}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding GitHub}" Value="{x:Null}">
                <Setter Property="ContentTemplate" Value="{StaticResource GitLineContent}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Path=(yard:GitPills.IsShown), RelativeSource={RelativeSource Self}}" Value="False">
                <Setter Property="ContentTemplate" Value="{StaticResource GitLineContent}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ContentControl.Style>
      </ContentControl>
    </DataTemplate>
  </Application.Resources>
</Application>
