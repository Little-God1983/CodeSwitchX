<Application x:Class="CodeSwitchX.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:CodeSwitchX.UI.Infrastructure"
             xmlns:yard="clr-namespace:CodeSwitchX.UI.Yard"
             ShutdownMode="OnMainWindowClose"
             ThemeMode="Dark">
  <Application.Resources>
    <infra:SessionStateToBrushConverter x:Key="StateBrush" />
    <infra:HexToBrushConverter x:Key="HexBrush" />
    <infra:PressureToBrushConverter x:Key="PressureBrush" />
    <infra:HostStateToTextConverter x:Key="HostStateText" />
    <infra:EnumEqualsToVisibilityConverter x:Key="EnumVisible" />
    <infra:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <BooleanToVisibilityConverter x:Key="BoolVisible" />
    <infra:TrueToCollapsedConverter x:Key="BoolCollapsed" />
    <infra:ModelDotToBrushConverter x:Key="DotBrush" />
    <infra:InvertBoolConverter x:Key="InvertBool" />
    <infra:IsNullConverter x:Key="IsNull" />
    <!-- A repository's line: on a tile, and in the header of its Raven chat. -->
    <DataTemplate x:Key="GitLineTemplate" DataType="{x:Type yard:GitLine}">
      <!-- the pill sits at the line's right edge, so the pills of every line and every tile line up; a long branch is
           trimmed to what is left, and a long folder name to a part of the line, so neither hides the other -->
      <Grid Margin="0,1" ToolTip="{Binding ToolTipText}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="&#xE9F5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" Opacity="0.75" />
        <TextBlock Grid.Column="1" Text="{Binding Folder}" MaxWidth="120" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.75" />
        <TextBlock Grid.Column="2" Text="{Binding Separator}" VerticalAlignment="Center" Opacity="0.75" />
        <TextBlock Grid.Column="3" Text="{Binding BranchText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.75" />
        <Border Grid.Column="4" CornerRadius="8" Padding="7,0,7,1" Margin="8,0,0,0" VerticalAlignment="Center" BorderThickness="1">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="#26F59E0B" />
              <Setter Property="BorderBrush" Value="#80F59E0B" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding GitStateLabel}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DirtyCount}" Value="0">
                  <Setter Property="Background" Value="#2622C55E" />
                  <Setter Property="BorderBrush" Value="#8022C55E" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding GitStateLabel}" FontSize="11" FontWeight="SemiBold">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F59E0B" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DirtyCount}" Value="0">
                    <Setter Property="Foreground" Value="#22C55E" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Border>
      </Grid>
    </DataTemplate>
  </Application.Resources>
</Application>
