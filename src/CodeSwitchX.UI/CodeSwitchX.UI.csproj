<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>CodeSwitchX</AssemblyName>
    <RootNamespace>CodeSwitchX.UI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeSwitchX.Core\CodeSwitchX.Core.csproj" />
    <ProjectReference Include="..\CodeSwitchX.Data\CodeSwitchX.Data.csproj" />
    <ProjectReference Include="..\CodeSwitchX.Ingest\CodeSwitchX.Ingest.csproj" />
    <ProjectReference Include="..\CodeSwitchX.Telemetry\CodeSwitchX.Telemetry.csproj" />
    <ProjectReference Include="..\CodeSwitchX.Hosting\CodeSwitchX.Hosting.csproj" />
    <ProjectReference Include="..\CodeSwitchX.Hook\CodeSwitchX.Hook.csproj" ReferenceOutputAssembly="false" Private="false" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Debug" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CodeSwitchX.UI.Tests" />
  </ItemGroup>
  <!--
    The relay is referenced for build order only (ReferenceOutputAssembly="false") and rides along as its own program in
    relay\csx-hook.exe, in the build output and in a publish alike. Its folder is asked of the project rather than assumed, so a
    runtime identifier (a win-x64 subfolder) does not leave the copy empty.
  -->
  <Target Name="CollectRelay">
    <MSBuild Projects="..\CodeSwitchX.Hook\CodeSwitchX.Hook.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="RelayTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <RelayDirectory>@(RelayTargetPath->'%(RootDir)%(Directory)')</RelayDirectory>
    </PropertyGroup>
    <ItemGroup>
      <RelayFiles Include="$(RelayDirectory)csx-hook.*" />
    </ItemGroup>
  </Target>
  <Target Name="CopyRelay" AfterTargets="Build" DependsOnTargets="CollectRelay">
    <Copy SourceFiles="@(RelayFiles)" DestinationFolder="$(OutDir)relay" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishRelay" AfterTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="CollectRelay">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(RelayFiles)">
        <RelativePath>relay\%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
