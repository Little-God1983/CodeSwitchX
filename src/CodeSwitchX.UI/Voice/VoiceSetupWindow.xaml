<Window x:Class="CodeSwitchX.UI.Voice.VoiceSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:voice="clr-namespace:CodeSwitchX.UI.Voice"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance voice:VoiceSetupViewModel}"
        Title="Raven · Voice setup" Width="760" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#4CC9E8" />
    <SolidColorBrush x:Key="AccentDim" Color="#163A47" />
    <SolidColorBrush x:Key="Panel" Color="#121A2B" />
    <SolidColorBrush x:Key="PanelLine" Color="#26324A" />
    <Style x:Key="Caps" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="Margin" Value="0,20,0,8" />
    </Style>
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Background" Value="#1E293B" />
    </Style>
    <!-- A card or a voice row: no selection chrome of the list's own; the template draws the selected state. -->
    <Style x:Key="Plain" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <StackPanel>
    <StackPanel Margin="28,20,28,20">
      <TextBlock Text="Choose how Raven speaks" FontSize="26" FontWeight="SemiBold" />
      <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,0"
                 Text="Pick a voice engine and a voice. It's installed now rather than the first time Raven answers. You can change both later in Settings." />

      <TextBlock Style="{StaticResource Caps}" Text="ENGINE" />
      <ListBox ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard}" ItemContainerStyle="{StaticResource Plain}"
               Background="Transparent" BorderThickness="0" AutomationProperties.Name="Voice engine"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               IsEnabled="{Binding IsInstalling, Converter={StaticResource InvertBool}}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="voice:EngineCard">
            <Border x:Name="Card" CornerRadius="8" BorderThickness="2" BorderBrush="{StaticResource PanelLine}" Background="{StaticResource Panel}"
                    Padding="16,14" Margin="0,0,6,0" AutomationProperties.Name="{Binding Name}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="20" Height="20" VerticalAlignment="Top" Margin="0,3,12,0">
                  <Ellipse Stroke="#94A3B8" StrokeThickness="2" />
                  <Ellipse x:Name="Pick" Width="9" Height="9" Fill="{StaticResource Accent}" Visibility="Collapsed" />
                </Grid>
                <StackPanel Grid.Column="1">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="Recommended" Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                               Visibility="{Binding Recommended, Converter={StaticResource BoolVisible}}" />
                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                  </DockPanel>
                  <TextBlock Text="{Binding Pitch}" TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,10" />
                  <ItemsControl ItemsSource="{Binding Tags}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource Chip}">
                          <TextBlock Text="{Binding}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <voice:ModelLampView DataContext="{Binding Lamp}" Margin="0,10,0,0" HorizontalAlignment="Left" />
                </StackPanel>
              </Grid>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Card" Property="Background" Value="#0F2A36" />
                <Setter TargetName="Pick" Property="Visibility" Value="Visible" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Style="{StaticResource Caps}" Text="{Binding VoiceHeading}" />
      <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource PanelLine}" Background="{StaticResource Panel}" Padding="6">
        <ListBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" ItemContainerStyle="{StaticResource Plain}"
                 Background="Transparent" BorderThickness="0" AutomationProperties.Name="Voice" MaxHeight="330"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 IsEnabled="{Binding IsInstalling, Converter={StaticResource InvertBool}}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="voice:VoiceRow">
              <Border x:Name="Row" CornerRadius="6" Padding="14,8" Background="Transparent" AutomationProperties.Name="{Binding Voice.Name}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Ellipse x:Name="Pick" Width="8" Height="8" Fill="{StaticResource Accent}" Visibility="Hidden" HorizontalAlignment="Left" />
                  <TextBlock Grid.Column="1" Text="{Binding Voice.Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Voice.Description}" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Button x:Name="Play" Grid.Column="3" Width="34" Height="34" Command="{Binding PlayCommand}" Content="&#x25B6;" FontSize="12"
                          AutomationProperties.Name="{Binding Voice.Name, StringFormat='Play {0}'}" ToolTip="Hear this voice">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" CornerRadius="17" BorderThickness="1.5" BorderBrush="#64748B" Background="Transparent">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource Accent}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </Grid>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentDim}" />
                  <Setter TargetName="Pick" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                  <Setter TargetName="Play" Property="Content" Value="&#x25A0;" />
                  <Setter TargetName="Play" Property="Foreground" Value="{StaticResource Accent}" />
                  <Setter TargetName="Play" Property="AutomationProperties.Name" Value="Stop" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </StackPanel>

    <!-- The footer: skip or install; the install's progress; ready; or why it failed. -->
    <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource PanelLine}" Padding="28,16">
      <Grid>
        <DockPanel Visibility="{Binding IsChoosing, Converter={StaticResource BoolVisible}}">
          <Button DockPanel.Dock="Right" Content="{Binding InstallText}" Command="{Binding InstallCommand}" MinWidth="140" Padding="16,8"
                  Background="{StaticResource Accent}" Foreground="#0B1220" FontWeight="SemiBold" IsDefault="True" />
          <Button DockPanel.Dock="Right" Content="{Binding CloseText}" Command="{Binding CloseCommand}" MinWidth="120" Padding="16,8" Margin="0,0,12,0" IsCancel="True" />
          <TextBlock Text="{Binding FooterText}" Opacity="0.75" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
        <DockPanel Visibility="{Binding IsInstalling, Converter={StaticResource BoolVisible}}">
          <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}" MinWidth="110" Padding="16,8" Margin="16,0,0,0" />
          <StackPanel VerticalAlignment="Center">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Amount}" Opacity="0.75" />
              <TextBlock Text="{Binding FooterText}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
            <ProgressBar Height="4" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay, TargetNullValue=0}"
                         IsIndeterminate="{Binding Progress, Converter={StaticResource IsNull}}" Foreground="{StaticResource Accent}" />
          </StackPanel>
        </DockPanel>
        <DockPanel Visibility="{Binding IsReady, Converter={StaticResource BoolVisible}}">
          <Button DockPanel.Dock="Right" Content="Done" Command="{Binding CloseCommand}" MinWidth="120" Padding="16,8"
                  Background="{StaticResource Accent}" Foreground="#0B1220" FontWeight="SemiBold" />
          <TextBlock Text="{Binding FooterText}" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
        <DockPanel Visibility="{Binding IsFailed, Converter={StaticResource BoolVisible}}">
          <Button DockPanel.Dock="Right" Content="Try again" Command="{Binding InstallCommand}" MinWidth="120" Padding="16,8" />
          <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseCommand}" MinWidth="100" Padding="16,8" Margin="0,0,12,0" />
          <TextBlock Text="{Binding FooterText}" Foreground="#F87171" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
        </DockPanel>
      </Grid>
    </Border>
  </StackPanel>
</Window>
